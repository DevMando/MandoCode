<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- dotnet tool settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mandocode</ToolCommandName>
    <PackageId>MandoCode</PackageId>

    <!-- NuGet metadata -->
    <Version>0.15.0</Version>
    <Authors>Armando Fernandez (DevMando)</Authors>
    <Description>Your AI coding assistant — run locally or in the cloud with Ollama. No API keys required. Just you and your code.</Description>
    <PackageProjectUrl>https://github.com/DevMando/MandoCode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DevMando/MandoCode</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai;cli;coding-assistant;ollama;agent-framework;local-llm;dotnet10;dotnet8</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>MC.png</PackageIcon>
    <ApplicationIcon>MC.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
    <!-- SK -> Agent Framework migration (feat/agent-framework-migration) is complete —
         Microsoft.SemanticKernel is no longer referenced anywhere in the codebase. See memory
         agent-framework-migration.md. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <!-- Microsoft.Agents.AI and .Workflows must move in lockstep: Workflows 1.19.0 declares
         Microsoft.Agents.AI (>= 1.19.0), so pairing it with 1.18.0 is an NU1605 downgrade —
         and TreatWarningsAsErrors turns that into a build error, not a warning.
         No <NoWarn> is needed: WorkflowBuilder, RequestPort, InProcessExecution,
         CheckpointManager and FileSystemJsonCheckpointStore carry no [Experimental]
         attribute in 1.19.0 (verified by reflection against the real assembly, not the docs
         — cf. the PipelineCompactionStrategy note below). -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.19.0" />
    <!-- analyzers excluded: OllamaSharp's source generator is built against Roslyn 5.6,
         newer than the compiler in current VS and .NET SDK builds, so loading it fails the
         build with CS9057. It only generates code for [OllamaTool]-annotated types, which
         this project does not use — MandoCode declares its tools its own way. -->
    <PackageReference Include="OllamaSharp" Version="5.4.30" ExcludeAssets="analyzers" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Held at 2.x on purpose: NAudio 3.x raised its floor to net9.0, which would drop the
         net8.0 build entirely. Revisit when net8.0 is dropped (November 2026). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="RazorConsole.Core" Version="0.5.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plan workflow's executors, messages and run context are internal on purpose — they are
         implementation detail of WorkflowPlanRunner, not API. The topology test needs to build the
         graph directly, and later phases test executors in isolation. -->
    <InternalsVisibleTo Include="MandoCode.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Audio\**\*.mp3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="MC.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
