@using RazorConsole.Core.Renderables
@using Spectre.Console

<CascadingValue Value="Pane">
    <Flex Direction="FlexDirection.Column" FillWidth="true" FillHeight="true">
        <Box Height="1" FillWidth="true">
            <Columns>
                <div data-focusable="true" data-focus-key="@($"agent-focus-{Pane.Id}")" @onclick="@(() => Pane.Workspace.Focus(Pane))" @onkeydown="@(key => HeaderKey(key, () => Pane.Workspace.Focus(Pane)))">
                    <Markup Content="@Spectre.Console.Markup.Escape($"Agent {Pane.Id} · {Pane.Model}")" Foreground="@(Pane.Active ? Color.Green : Color.Grey)" />
                </div>
                <div data-focusable="true" data-focus-key="@($"agent-new-{Pane.Id}")" @onclick="@(() => Pane.Workspace.Add())" @onkeydown="@(key => HeaderKey(key, () => Pane.Workspace.Add()))"><Markup Content="+ New" /></div>
                <div data-focusable="true" data-focus-key="@($"agent-close-{Pane.Id}")" @onclick="@(() => Pane.Workspace.Close(Pane))" @onkeydown="@(key => HeaderKey(key, () => Pane.Workspace.Close(Pane)))"><Markup Content="× Close" /></div>
            </Columns>
        </Box>
        <Box FillWidth="true" FillHeight="true">
            @if (AgentBody is not null) { @AgentBody(Pane) }
            else { <App /> }
        </Box>
    </Flex>
</CascadingValue>

@code {
    [Parameter, EditorRequired] public AgentPane Pane { get; set; } = default!;
    [Parameter] public RenderFragment<AgentPane>? AgentBody { get; set; }
    private void HeaderKey(KeyboardEventArgs key, Action action)
    {
        if (Pane.Workspace.Key(Pane, key)) return;
        if (key.Key is "Enter" or "Return" or " ") action();
    }
}
