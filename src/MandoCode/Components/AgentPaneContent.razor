@using Spectre.Console
@using RazorConsole.Core.Renderables
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
<CascadingValue Value="Pane">
    <Flex Direction="FlexDirection.Column" FillWidth="true" FillHeight="true">
        <Box Height="1" FillWidth="true">
            @if (Pane.Visible && Pane.Workspace.Registry?.IsWorkspacePickerOpen != true)
            {
                <Flex Direction="FlexDirection.Row" FillWidth="true">
                    @if (NameWidth > 0)
                    {
                    <Box Width="@NameWidth"><WorkspaceButton Content="@Caption(Pane.Name + (Pane.IsAwaitingInput?.Invoke() == true ? " !" : ""), NameWidth)" Selected="Pane.Active"
                        Background="@HeaderBackground" MutedBackground="@MutedHeaderBackground"
                        SelectedBackground="@(new Color(80, 55, 101))" HoverBackground="@(new Color(96, 69, 119))"
                        OnClick="@(() => Pane.Workspace.Focus(Pane))" /></Box>
                    }
                    <Box Width="@ModelWidth"><WorkspaceButton Content="@Caption(Pane.Model, ModelWidth)"
                        Background="@HeaderBackground" MutedBackground="@MutedHeaderBackground"
                        SelectedBackground="@(new Color(80, 55, 101))" HoverBackground="@(new Color(96, 69, 119))"
                        OnClick="PickModel" /></Box>
                    <Box Width="@SettingsWidth"><WorkspaceButton Content="@Caption(SettingsWidth >= 24 ? "Agent Settings (Alt+S)" : SettingsWidth >= 16 ? "Agent Settings" : "Settings", SettingsWidth)" Background="@HeaderBackground" MutedBackground="@MutedHeaderBackground" OnClick="ShowSettings" /></Box>
                    <Box Width="@SnapshotsWidth"><WorkspaceButton Content="@Caption(SnapshotsWidth >= 27 ? "Context Snapshots (Alt+C)" : SnapshotsWidth >= 19 ? "Snapshots (Alt+C)" : "Snapshots", SnapshotsWidth)" Background="@HeaderBackground" MutedBackground="@MutedHeaderBackground" OnClick="ShowSnapshots" /></Box>
                    @if (HeaderGap > 0) { <Box Width="@HeaderGap"><Markup Content="@(new string(' ', HeaderGap))" Background="@EffectiveHeaderBackground" /></Box> }
                    @if (GitWidth > 0 && _git is not null)
                    {
                        @if (ChangesWidth > 0)
                        {
                            <Box Width="@ChangesWidth"><WorkspaceButton Content="@(ChangesWidth >= 21 ? " Git Changes (Alt+G) " : ChangesWidth >= 13 ? " Git Changes " : ChangesWidth >= 9 ? " Changes " : " ± ")" Background="@HeaderBackground" MutedBackground="@MutedHeaderBackground" OnClick="ShowChanges" /></Box>
                        }
                        <Box Width="@GitWidth">
                            <Flex Direction="FlexDirection.Row">
                                <Markup Content=" ⎇ " Foreground="@PaneColors.For(Pane, Color.Grey85)" Background="@EffectiveHeaderBackground" />
                                <Markup Content=" ● " Foreground="@PaneColors.For(Pane, _git.Conflicted ? Color.Red : _git.Dirty ? Color.Gold1 : Color.Green)" Background="@EffectiveHeaderBackground" />
                                <Markup Content="@Caption(_git.Label, GitWidth - 6)" Foreground="@PaneColors.For(Pane, Color.Grey85)" Background="@EffectiveHeaderBackground" />
                            </Flex>
                        </Box>
                    }
                </Flex>
            }
        </Box>
        <Box FillWidth="true" FillHeight="true">
            @if (AgentBody is not null) { @AgentBody(Pane) }
            else { <App /> }
        </Box>
    </Flex>
</CascadingValue>

@code {
    [Parameter, EditorRequired] public AgentPane Pane { get; set; } = default!;
    [Parameter] public RenderFragment<AgentPane>? AgentBody { get; set; }
    private static readonly Color HeaderBackground = new(36, 41, 47);
    private static readonly Color MutedHeaderBackground = new(38, 38, 38);
    private Color EffectiveHeaderBackground => PaneColors.Muted(Pane) ? MutedHeaderBackground : HeaderBackground;
    private GitPaneSnapshot? _git;
    private readonly CancellationTokenSource _shutdown = new();
    private int GitBudget => Pane.Width - NameWidth - SettingsWidth - SnapshotsWidth - DesiredChangesWidth - 16;
    private int GitWidth => _git is null || Pane.Width < 35 || GitBudget < 8 ? 0 : Math.Min(Math.Min(39, Math.Min(Pane.Width / 3, GitBudget)), RazorConsole.Core.Input.TextSelectionState.CellWidth(_git.Label) + 8);
    private int NameWidth => Pane.Workspace.Panes.Count == 1 ? 0 : Math.Min(Math.Max(1, Pane.Width / 4), Math.Max(1, RazorConsole.Core.Input.TextSelectionState.CellWidth(Pane.Name) + 4));
    private int DesiredChangesWidth => _git?.Dirty != true ? 0 : Pane.Width >= 90 ? 21 : Pane.Width >= 70 ? 13 : Pane.Width >= 55 ? 9 : 3;
    private int ChangesWidth => GitWidth == 0 ? 0 : DesiredChangesWidth;
    private int SettingsWidth => Pane.Width >= 110 ? 24 : Pane.Width >= 65 ? 16 : Math.Min(10, Math.Max(1, Pane.Width / 3));
    private int SnapshotsWidth => Pane.Width >= 150 ? 27 : Pane.Width >= 110 ? 20 : Math.Min(12, Math.Max(1, Pane.Width / 5));
    private async Task ShowSnapshots() { Pane.Workspace.Focus(Pane); if (Pane.ToggleSnapshots is not null) await Pane.ToggleSnapshots(); }
    private int ModelWidth => Math.Min(48, Math.Max(1, Pane.Width - NameWidth - GitWidth - ChangesWidth - SettingsWidth - SnapshotsWidth));
    private int HeaderGap => Math.Max(0, Pane.Width - NameWidth - ModelWidth - SettingsWidth - SnapshotsWidth - GitWidth - ChangesWidth);
    private async Task ShowSettings() { Pane.Workspace.Focus(Pane); if (Pane.ToggleSettings is not null) await Pane.ToggleSettings(); }
    private async Task ShowChanges() { Pane.Workspace.Focus(Pane); if (Pane.ToggleGitChanges is not null) await Pane.ToggleGitChanges(); }
    protected override void OnInitialized() => _ = RefreshGitAsync();
    private async Task RefreshGitAsync()
    {
        var rootAccessor = Pane.Services.GetRequiredService<ProjectRootAccessor>();
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            do
            {
                if (!Pane.Visible) continue;
                var root = rootAccessor.ProjectRoot;
                var status = await GitPaneStatus.ReadAsync(root, _shutdown.Token);
                if (_shutdown.IsCancellationRequested) break;
                await InvokeAsync(() =>
                {
                    _git = root == rootAccessor.ProjectRoot ? status : null;
                    StateHasChanged();
                });
            } while (await timer.WaitForNextTickAsync(_shutdown.Token));
        }
        catch (OperationCanceledException) when (_shutdown.IsCancellationRequested) { }
    }
    public void Dispose() { _shutdown.Cancel(); _shutdown.Dispose(); }
    private static string Caption(string text, int width)
    {
        var label = WorkspaceTabWindow.Fit($" {text} ", width);
        return Spectre.Console.Markup.Escape(label + new string(' ', Math.Max(0, width - RazorConsole.Core.Input.TextSelectionState.CellWidth(label))));
    }
    private async Task PickModel()
    {
        if (Pane.IsBusy?.Invoke() == true || Pane.IsAwaitingInput?.Invoke() == true || Pane.SubmitCommand is null) return;
        Pane.Workspace.Focus(Pane);
        await Pane.SubmitCommand("/model");
    }
}
