@using MandoCode.Models
@using Spectre.Console
@using RazorConsole.Core.Renderables
@using RazorConsole.Core.Input
@using Microsoft.Extensions.DependencyInjection
@inject RazorConsole.Core.Focus.FocusManager Focus
@implements IDisposable

<Box FillWidth="true" FillHeight="true" Border="BoxBorder.Rounded" Title="@(_kind == 0 ? "MCP Servers" : "Skills")" BorderColor="@PaneColors.For(Pane, Color.Purple)">
 <Flex Direction="FlexDirection.Column" FillWidth="true" FillHeight="true">
  @if (_installBrowser) {
   <DirectoryBrowser InitialDirectory="@InstallDirectory" Width="@Width" Height="@Height" OnComplete="CompleteFolderInstall" />
  }
  else if (_tools is not null) {
   <McpToolsViewer ServerName="@_toolsServer" Tools="@_tools" Width="@Width" Height="@Height" OnClose="@(() => _tools = null)" />
  }
  else if (_input is not null)
  {
   <PlanStepEditor @key="_inputId" Title="@_inputTitle" InitialValue="@_inputValue" ReadOnly="@_inputReadOnly" Width="@Width" Height="@Math.Max(5, Height - 5)" OnSubmit="SubmitInput" OnCancel="CancelInput" />
  }
  else
  {
   <div @key="_focusKey" data-focusable="@(Pane is null || Pane.Active)" data-input-managed="true" data-manage-tab="true" @onkeydown="Key">
    <Rows>
     @foreach (var line in _mode == "list" ? Array.Empty<string>() : Wrap(_mode == "mcp" ? "Configure a server, test its connection, then save to connect open agents." : _mode == "skill-choice" ? "How would you like to create your skill?" : _mode == "skill-ai" ? "Describe your skill. AI will draft the name, description, and instructions." : "Fill out the fields below. Review your instructions before saving."))
     { <Markup Content="@Escape(line)" Foreground="Color.Grey70" /> }
     @if (_mode == "list")
     {
      @if (IsTable) {
       <Flex Direction="FlexDirection.Row" Height="3">
        <Box Width="@SearchWidth" Height="3" Border="BoxBorder.Rounded" Title="@(_kind == 0 ? "Search MCP Servers" : "Search Skills")" BorderColor="@(SearchSelected ? Color.Green : Color.Grey50)">
         <div data-focusable="false" @onclick="SelectSearch"><TextArea Buffer="@_searchBuffer" Editable="true" Width="@Math.Max(1, SearchWidth - 2)" Height="1" WordWrap="false" CharacterStyle="@(_ => new Style(ValueColor))" Hook="@_searchKey" OnPreviewKey="SearchKey" OnChanged="SearchChanged" /></div>
        </Box>
        <Box Width="2"><Markup Content=" " /></Box>
        @ToolbarButton(_kind == 0 ? "Add Server" : "New Skill", _kind == 0 ? "+MCP Server" : "+Skill", AddServerWidth)
        @if (_kind == 1) { <Box Width="2"><Markup Content=" " /></Box>@ToolbarButton("Install from Git / ZIP / Folder", "Install", InstallWidth) }
       </Flex>
      }

      @if (IsTable)
      {
       <Flex Direction="FlexDirection.Row">
        <Box Width="@NameWidth"><Markup Content="@(_kind == 0 ? "Server" : "Skill")" Foreground="Color.Purple" /></Box>
        @if (_kind == 0) { <Box Width="@ColumnGap"><Markup Content=" " /></Box><Box Width="@InfoWidth"><Markup Content="Type / Status" Foreground="Color.Purple" /></Box> }
        @if (InlineRowActions) { <Box Width="@ColumnGap"><Markup Content=" " /></Box> }
        @if (InlineRowActions) { <Box Width="@RowActionsWidth"><Markup Content="Actions" Foreground="Color.Purple" /></Box> }
       </Flex>
       <Markup Content="@(new string('─', TableWidth))" Foreground="Color.Grey50" />
      }
      @if (Rows.Length == 0) { <Markup Content="@(_kind == 0 ? "No matching servers. Clear the search or choose +MCP Server." : "No matching skills. Use New Skill or Install to get started.")" Foreground="Color.Grey70" /> }
     }
     @foreach (var index in VisibleRows)
     {
      @if (IsTable)
      {
       var selection = index * RowSlots;
       <Rows>
        <Flex Direction="FlexDirection.Row">
         <Box Width="@NameWidth"><div data-focusable="false" @onclick="@(() => Activate(selection))"><Markup Content="@Escape(WorkspaceTabWindow.Fit((_selected == selection ? "> " : "  ") + RowName(index), NameWidth))" Foreground="@(_selected == selection ? SelectionForeground : RowColor(index))" Background="@(_selected == selection ? SelectionBackground : Color.Default)" /></div></Box>
         @if (_kind == 0) { <Box Width="@ColumnGap"><Markup Content=" " /></Box><Box Width="@InfoWidth"><Markup Content="@Escape(WorkspaceTabWindow.Fit(RowInfo(index), InfoWidth))" Foreground="@RowColor(index)" /></Box> }
         @if (InlineRowActions) { <Box Width="@ColumnGap"><Markup Content=" " /></Box> }
         @if (InlineRowActions) { @RowButtons(index, 1, RowSlots - 1) }
        </Flex>
        @if (!InlineRowActions)
        {
         @for (var start = 1; start < RowSlots; start += RowButtonColumns) { var offset = start;
          <Flex Direction="FlexDirection.Row">
           <Box Width="@(TableWidth - Math.Min(RowButtonColumns, RowSlots - offset) * RowButtonWidth)"><Markup Content=" " /></Box>
           @RowButtons(index, offset, Math.Min(RowButtonColumns, RowSlots - offset))
          </Flex>
         }
        }
       </Rows>
      }
      else
      {
       @if (InlineField(index) is { } field) {
        <Box Border="BoxBorder.Rounded" Title="@field" Height="3" Width="@TableWidth" BorderColor="@(index == _selected ? Color.Green : Color.Grey50)">
         @if (index == _selected) {
          <div data-focusable="false" @onclick="@(() => Select(index))"><TextArea @key="InlineIdentity" Buffer="@InlineBuffer" Editable="true" Width="@Math.Max(1, TableWidth - 2)" Height="1" WordWrap="false" CharacterStyle="@(_ => new Style(ValueColor))" Hook="@_inlineKey" OnPreviewKey="InlineKey" OnChanged="InlineChanged" /></div>
         } else {
          <div data-focusable="false" @onclick="@(() => Select(index))"><RenderableContent Content="@(new Text(InlineValue(field), new Style(ValueColor)))" /></div>
         }
        </Box>
        @if (_kind == 1) { @foreach (var hint in Wrap(SkillFieldHelp(field))) { <Markup Content="@Escape(hint)" Foreground="Color.Grey62" /> } }
       } else {
       <div data-focusable="false" @onclick="@(() => Activate(index))"><Rows>
        @foreach (var line in Wrap(RowLabels[index], 2).Take(PageSize).Select((text, row) => (text, row)))
        {
         @if (_mode == "mcp") { <RenderableContent Content="@McpFieldLine(index, line.text, line.row)" /> }
         else { <Markup Content="@Escape((line.row == 0 && index == _selected ? "> " : "  ") + line.text)" Foreground="@(index == _selected ? SelectionForeground : RowColor(index))" Background="@(index == _selected ? SelectionBackground : Color.Default)" /> }
        }
        @if (_mode is "skill" or "skill-ai" or "skill-refine") {
         @foreach (var hint in Wrap(SkillFieldHelp(SkillFields[index]), 2)) { <Markup Content="@Escape("  " + hint)" Foreground="Color.Grey62" /> }
         <Markup Content=" " />
        }
       </Rows></div>
       }
      }
     }
    </Rows>
   </div>

   @if (IsTable && SelectedRow is not null) {
    <Markup Content="@(new string('─', TableWidth))" Foreground="Color.Grey50" />
    @foreach (var line in Wrap(SelectedTitle)) { <Markup Content="@Escape(line)" Foreground="Color.Purple" /> }
   }
   <Box Height="@DescriptionLines.Length"><Rows>@foreach (var line in DescriptionLines) { <Markup Content="@Escape(line)" Foreground="Color.Grey70" /> }</Rows></Box>
   @if (IsTable) { <Box FillHeight="true"><Markup Content=" " /></Box> }
   else { <Markup Content=" " /> }
   <Markup Content="@(new string('─', TableWidth))" Foreground="Color.Grey50" />
   @if (_busy) { <Markup Content="@($"{Frames[_frame % Frames.Length]} {_status}")" Foreground="Color.Purple" /> }
   else { <Box Height="@StatusLines.Length"><Rows>@foreach (var line in StatusLines) { <Markup Content="@Escape(line)" Foreground="Color.Green" /> }</Rows></Box> }
   @ActionButtons(false)
   @if ((_kind == 1 && !IsTable) || _mode == "mcp") { <Markup Content="@(new string('─', TableWidth))" Foreground="Color.Grey50" /> }
   @if (_mode == "list") { <Markup Content="@(_kind == 0 ? "Global MCP settings" : "Global skills")" Foreground="Color.Grey62" /> }
   @if (Config.ShowTips) { <Rows>@foreach (var line in Wrap(Tip)) { <Markup Content="@line" Foreground="Color.Grey62" /> }</Rows> }
   @if (!IsTable) { <Box FillHeight="true"><Markup Content=" " /></Box> }
  }
 </Flex>
</Box>

@code {
 [CascadingParameter] public AgentPane? Pane { get; set; }
 [CascadingParameter] public ExplorerFocusScope? ExplorerFocus { get; set; }
 [Parameter] public MandoCodeConfig Config { get; set; } = default!;
 [Parameter] public CliIntegrationCoordinator Coordinator { get; set; } = default!;
 [Parameter] public int Kind { get; set; }
 [Parameter] public int Width { get; set; } = 60;
 [Parameter] public int Height { get; set; } = 24;
 [Parameter] public EventCallback OnClose { get; set; }
 private IReadOnlyList<McpToolsViewer.ToolDescription>? _tools;
 private string _toolsServer = "";
 private bool _installBrowser;
 private string InstallDirectory => Pane?.Services.GetRequiredService<ProjectRootAccessor>().ProjectRoot ?? Environment.CurrentDirectory;
 private int _kind, _selected, _row, _frame;
 private bool _busy, _inputReadOnly;
 private string _mode = "list", _query = "", _status = "", _inputTitle = "", _inputValue = "", _inputId = "";
 private Func<string, Task>? _input;
 private Dictionary<string, McpServerConfig> _servers = new(StringComparer.OrdinalIgnoreCase);
 private IReadOnlyList<SkillManagementStore.Entry> _skills = [];
 private string _name = "", _originalName = "", _intent = "", _description = "", _body = "", _model = "";
 private string? _skillFolder;
 private string? _rowKey;
 private McpServerConfig _server = new();
 private string? _confirmAction;
 private int _confirmationSelection;
 private readonly string _focusKey = "integrations-" + Guid.NewGuid().ToString("N");
 private readonly string _inlineKey = "integration-field-" + Guid.NewGuid().ToString("N");
 private static readonly Color ValueColor = new(255, 200, 80);
 private Spectre.Console.Markup McpFieldLine(int index, string line, int row)
 {
  var label = McpFields[index] + ": ";
  var start = Math.Max(0, RowLabels[index].IndexOf(line, StringComparison.Ordinal));
  var count = Math.Clamp(label.Length - start, 0, line.Length);
  string Paint(string text, Color color) => $"[{color.ToMarkup()}{(index == _selected ? " on " + SelectionBackground.ToMarkup() : "")}]" + Escape(text) + "[/]";
  return new Spectre.Console.Markup(
   Paint(row == 0 && index == _selected ? "> " : "  ", index == _selected ? SelectionForeground : Color.Green)
   + Paint(line[..count], index == _selected ? SelectionForeground : Color.Green)
   + Paint(line[count..], index == _selected ? SelectionForeground : ValueColor));
 }
 private Color SelectionForeground => _kind == 1 && !IsTable ? Color.White : Color.Black;
 private Color SelectionBackground => _kind == 1 && !IsTable ? new Color(80, 55, 101) : Color.DeepSkyBlue1;
 private readonly string _searchKey = "mcp-search-" + Guid.NewGuid().ToString("N");
 private readonly TextSelectionState _searchBuffer = new();
 private int AddServerWidth => Math.Min(_kind == 0 ? 16 : 10, Math.Max(1, TableWidth / 3));
 private int InstallWidth => Math.Min(11, Math.Max(1, TableWidth / 3));
 private int SearchWidth => Math.Max(3, TableWidth - AddServerWidth - 2 - (_kind == 1 ? InstallWidth + 2 : 0));
 private RenderFragment ToolbarButton(string action, string label, int width) => @<Box Width="@width" Height="3" Border="BoxBorder.Rounded" BorderColor="Color.Grey50"><div data-focusable="false" @onclick="@(() => Activate(OptionCount + Array.IndexOf(Actions, action)))"><Markup Content="@Escape(WorkspaceTabWindow.Fit((_selected == OptionCount + Array.IndexOf(Actions, action) ? "> " : "  ") + label, Math.Max(1, width - 2)))" Foreground="@(_selected == OptionCount + Array.IndexOf(Actions, action) ? SelectionForeground : Color.Grey85)" Background="@(_selected == OptionCount + Array.IndexOf(Actions, action) ? SelectionBackground : new Color(22, 26, 30))" /></div></Box>;
 private bool SearchSelected => IsTable && _selected == OptionCount + Array.IndexOf(Actions, "Search");
 private void SelectSearch() { Select(OptionCount + Array.IndexOf(Actions, "Search")); }
 private void SearchChanged() { _query = _searchBuffer.Text; _row = 0; _rowKey = Rows.FirstOrDefault(); _selected = OptionCount + Array.IndexOf(Actions, "Search"); }
 private async Task<bool> SearchKey(KeyboardEventArgs key) {
  if (Pane is { Active: false }) return true;
  if ((key.AltKey || key.MetaKey) && Pane?.Workspace.Key(Pane, key) == true) return true;
  if (key.Key == "Tab") { await Cycle(key.ShiftKey); return true; }
  if (key.Key is "ArrowDown" or "Enter" or "Return") { Select(OptionCount > 0 ? 0 : OptionCount + Array.IndexOf(Actions, _kind == 0 ? "Add Server" : "New Skill")); return true; }
  if (key.Key == "Escape") { await OnClose.InvokeAsync(); return true; }
  return false;
 }
 private string FocusTarget => SearchSelected && !_busy ? _searchKey : InlineField(_selected) is null || _busy ? _focusKey : _inlineKey;
 private readonly TextSelectionState _inlineBuffer = new();
 private string _inlineIdentity = "";
 private string InlineIdentity => _mode + ":" + _selected;
 private string? InlineField(int index) => _confirmAction is not null ? null : _mode == "mcp" ? McpFields.ElementAtOrDefault(index) is "Name" or "URL" or "Command" ? McpFields[index] : null : _mode is "skill" or "skill-ai" or "skill-refine" ? SkillFields.ElementAtOrDefault(index) is { } field && field is not "Model" and not "Instructions" ? field : null : null;
 private string InlineValue(string field) => _mode == "mcp" ? McpValue(field) : SkillValue(field);
 private TextSelectionState InlineBuffer { get { if (_inlineIdentity != InlineIdentity) { _inlineIdentity = InlineIdentity; _inlineBuffer.SetText(InlineValue(InlineField(_selected)!)); } return _inlineBuffer; } }
 private void InlineChanged() {
  var value = _inlineBuffer.Text;
  switch (InlineField(_selected)) {
   case "Name": _name = value; break;
   case "URL": _server.Url = value; break;
   case "Command": _server.Command = value; break;
   case "Description": _description = value; break;
   default: _intent = value; break;
  }
  _status = "";
 }
 private async Task<bool> InlineKey(KeyboardEventArgs key) {
  if (Pane is { Active: false }) return true;
  if ((key.AltKey || key.MetaKey) && Pane?.Workspace.Key(Pane, key) == true) return true;
  if (key.Key is "Enter" or "Return") return true;
  if (key.Key is "Tab" or "Escape" or "ArrowUp" or "ArrowDown") { await Key(key); return true; }
  return false;
 }
 private readonly CancellationTokenSource _shutdown = new();
 private static readonly string[] Frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
 private AgentPane[] Agents => (Pane?.Workspace.Registry?.Workspaces.SelectMany(w => w.Panes) ?? Pane?.Workspace.Panes ?? Array.Empty<AgentPane>()).ToArray();
 private string[] Rows => _kind == 0 ? _servers.Keys.Where(name => name.Contains(_query, StringComparison.OrdinalIgnoreCase)).OrderByDescending(name => !_servers[name].Disabled).ThenBy(name => name, StringComparer.OrdinalIgnoreCase).ToArray()
  : _skills.Where(skill => skill.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) || skill.Description.Contains(_query, StringComparison.OrdinalIgnoreCase)).Select(skill => skill.Folder).ToArray();
 private string? SelectedRow => _rowKey is not null && Rows.Contains(_rowKey) ? _rowKey : Rows.ElementAtOrDefault(_row);
 private SkillManagementStore.Entry? SelectedSkill => _skills.FirstOrDefault(skill => skill.Folder == SelectedRow);
 private string McpStatus(string name) => _servers[name].Disabled ? "disabled" : !Config.EnableMcp ? "off for this agent" : Pane?.Services.GetRequiredService<McpClientManager>().ActiveClients.ContainsKey(name) == true ? "connected" : Pane?.Services.GetRequiredService<McpClientManager>().StartupErrors.ContainsKey(name) == true ? "failed" : "not connected";
 private string[] McpFields => _server.IsHttp ? ["Name", "Transport", "URL", "Headers", "Enabled"] : ["Name", "Transport", "Command", "Arguments", "Environment", "Enabled"];
 private string[] SkillFields => _mode == "skill-ai" ? ["What should this skill do?", "Model"] : _mode == "skill-refine" ? ["Refinement request", "Model"] : ["Name", "Description", "Instructions"];
 private string _modelReturnMode = "skill";
 private int _modelReturnSelection = 3;
 private string[] _modelChoices = [];
 private string[] RowLabels => _confirmAction is not null ? [] : _mode is "skill-choice" or "skill-install" ? [] : _mode == "models" ? _modelChoices : _mode == "mcp" ? McpFields.Select(label => label + ": " + McpValue(label)).ToArray()
  : _mode is "skill" or "skill-ai" or "skill-refine" ? SkillFields.Select(label => label + ": " + SkillValue(label)).ToArray()
  : Rows.Select(row => _kind == 0 ? row + " · " + (_servers[row].IsHttp ? "http" : "stdio") + " · " + McpStatus(row) : _skills.First(s => s.Folder == row).Name + " · " + (_skills.First(s => s.Folder == row).Enabled ? "enabled" : "disabled")).ToArray();
 private string[] Actions => _confirmAction is not null ? ["Cancel", "Confirm " + _confirmAction] : _mode == "models" ? ["Cancel"] : _mode == "mcp" ? ["Test Connection", "Save & Connect", "Cancel"] : _mode == "skill-install" ? ["Choose Folder", "Git URL or ZIP", "Cancel"] : _mode == "skill-refine" ? ["Apply Refinement", "Back to Form"] : _mode == "skill-choice" ? ["Write Manually", "Create with AI", "Cancel"] : _mode == "skill-ai" ? ["Generate Skill", "Cancel"] : _mode == "skill" ? ["Save", "Cancel", "Refine with AI"]
  : _kind == 0 ? ["Search", "Add Server", "Close", "Enable All / Disable All", "Refresh"]
  : ["Search", "New Skill", "Install from Git / ZIP / Folder", "Enable All / Disable All", "Refresh", "Close"];
 private bool IsTable => _mode == "list" && _confirmAction is null;
 private string[] RowActions => _kind == 0 ? ["Details", "Enable / Disable", "Edit", "Remove", "Tools"] : ["Details", "Enable / Disable", "Edit", "Remove"];
 private int RowSlots => RowActions.Length;
 private int OptionCount => IsTable ? Rows.Length * RowSlots : RowLabels.Length;
 private int TableWidth => Math.Max(1, Width - 4);
 private int RowButtonWidth => Math.Min(10, TableWidth);
 private int RowActionsWidth => (RowSlots - 1) * RowButtonWidth;
 private bool InlineRowActions => TableWidth >= RowActionsWidth + 30;
 private int RowButtonColumns => Math.Max(1, TableWidth / RowButtonWidth);
 private int TableRowHeight => InlineRowActions ? 1 : 1 + (RowSlots - 2 + RowButtonColumns) / RowButtonColumns;
 private int ColumnGap => TableWidth >= 8 ? 2 : 0;
 private int InfoWidth => Math.Max(1, (TableWidth - ColumnGap - (InlineRowActions ? RowActionsWidth + ColumnGap : 0)) / 2);
 private int NameWidth => _kind == 1 ? Math.Max(1, TableWidth - (InlineRowActions ? RowActionsWidth + ColumnGap : 0)) : Math.Max(1, TableWidth - ColumnGap - (InlineRowActions ? RowActionsWidth + ColumnGap : 0) - InfoWidth);
 private string RowName(int index) => _kind == 0 ? Rows[index] : _skills.First(skill => skill.Folder == Rows[index]).Name;
 private string RowInfo(int index) => _kind == 0 ? (_servers[Rows[index]].IsHttp ? "http" : "stdio") + " / " + McpStatus(Rows[index]) : _skills.First(skill => skill.Folder == Rows[index]).Description;
 private bool RowEnabled(int index) => _kind == 0 ? !_servers[Rows[index]].Disabled : _skills.First(skill => skill.Folder == Rows[index]).Enabled;
 private RenderFragment RowButtons(int row, int start, int count) => @<Flex Direction="FlexDirection.Row">
  @for (var cell = start; cell < start + count; cell++) { var index = row * RowSlots + cell; var action = RowActions[cell]; var label = action == "Enable / Disable" ? RowEnabled(row) ? "Active" : "Disabled" : action == "Remove" ? "Delete" : action;
   <Box Width="@RowButtonWidth"><div data-focusable="false" data-integration-action="@action" data-integration-item="@Rows[row]" @onclick="@(() => Activate(index))"><Markup Content="@Escape(WorkspaceTabWindow.Fit((_selected == index ? "> " : "  ") + label, RowButtonWidth))" Foreground="@(_selected == index ? SelectionForeground : action == "Remove" ? Color.Red : action == "Enable / Disable" ? RowEnabled(row) ? Color.Green : Color.White : Color.Grey85)" Background="@(_selected == index ? SelectionBackground : new Color(22, 26, 30))" /></div></Box>
  }
 </Flex>;
 private bool IsTopAction(string action) => action is "Add Server" or "New Skill" or "Install from Git / ZIP / Folder" or "Search";
 private RenderFragment ActionButtons(bool top) => @<Rows>
  @{ var indices = Enumerable.Range(0, Actions.Length).Where(i => IsTable && top ? IsTopAction(Actions[i]) : !top && (!IsTable || !IsTopAction(Actions[i]))).ToArray(); }
  @for (var row = 0; row < (indices.Length + ActionColumns - 1) / ActionColumns; row++) { var offset = row * ActionColumns;
   <Box Height="1"><Flex Direction="FlexDirection.Row">
    @foreach (var i in indices.Skip(offset).Take(ActionColumns)) { var index = OptionCount + i; var action = Actions[i];
     <Box Width="@ActionWidth"><div data-focusable="false" @onclick="@(() => Activate(index))"><Markup Content="@Escape((index == _selected ? "> " : "  ") + ActionLabel(action))" Foreground="@(index == _selected ? SelectionForeground : Color.Grey85)" Background="@(index == _selected ? SelectionBackground : new Color(22, 26, 30))" /></div></Box>
    }
   </Flex></Box>
  }
 </Rows>;
 private string SelectedTitle => _kind == 0 ? SelectedRow ?? "" : SelectedSkill?.Name ?? "";
 private string Tip => IsTable ? "↑/↓ rows · ←/→ actions · Tab next · Enter choose/toggle status · Esc back" : "Type in outlined fields · ↑/↓ or Tab next · ←/→ buttons · Enter choose · Esc back";
 private string McpValue(string field) => field switch {
  "Name" => _name, "Transport" => _server.IsHttp ? "http" : "stdio", "URL" => _server.Url ?? "", "Command" => _server.Command ?? "", "Arguments" => string.Join(" ", _server.Args), "Headers" => _server.Headers.Count + " entries", "Environment" => _server.Env.Count + " entries", _ => _server.Disabled ? "Off" : "On" };
 private string SkillFieldHelp(string field) => field switch {
  "Name" => "A short, recognizable name, such as Review Pull Requests.",
  "Description" => "Explain what the skill does and when the agent should use it.",
  "Instructions" => "Describe the steps, rules, and expected output. Enter opens a multiline editor.",
  "Model" => "The model used to create or refine this draft.",
  "What should this skill do?" => "Example: Review C# code for bugs and readability. Explain each issue and suggest a fix.",
  _ => "Optional: describe changes you want, then choose Refine with AI."
 };
 private int FieldHeight(int index) => InlineField(index) is { } field ? 3 + (_kind == 1 ? Wrap(SkillFieldHelp(field)).Length : 0) : Wrap(RowLabels[index], 2).Length + (_mode is "skill" or "skill-ai" or "skill-refine" ? Wrap(SkillFieldHelp(SkillFields[index]), 2).Length + 1 : 0);
 private string SkillValue(string field) => field switch { "Name" => _name, "Description" => _description, "Instructions" => _body.Length + " characters", "Model" => _model, _ => _intent };
 private string Escape(string text) => Spectre.Console.Markup.Escape(text);
 private string[] Wrap(string text, int reserve = 0) => AgentSettingsDraft.Wrap(text, Math.Max(1, Width - 4 - reserve));
 private string[] StatusLines => Wrap(_status).Take(3).ToArray();
 private string[] DescriptionLines => Wrap(Description).Take(IsTable ? Math.Max(3, Math.Min(10, Height / 3)) : 3).ToArray();
 private int ActionColumns => Width >= 64 && _confirmAction is null ? 3 : Width >= 44 ? 2 : 1;
 private int ActionWidth => Math.Max(1, (Width - 4) / ActionColumns);
 private int ActionRows => IsTable ? (Actions.Count(IsTopAction) + ActionColumns - 1) / ActionColumns + (Actions.Count(action => !IsTopAction(action)) + ActionColumns - 1) / ActionColumns : (Actions.Length + ActionColumns - 1) / ActionColumns;
 private bool SelectedEnabled => _kind == 0 ? SelectedRow is { } name && !_servers[name].Disabled : SelectedSkill?.Enabled == true;
 private bool AnyEnabled => _kind == 0 ? Rows.Any(name => !_servers[name].Disabled) : _skills.Any(skill => Rows.Contains(skill.Folder) && skill.Enabled);
 private string ActionLabel(string action) => action switch { "Install from Git / ZIP / Folder" => "Install", "Enable All / Disable All" => AnyEnabled ? "Disable All" : "Enable All", "Enable / Disable" => SelectedEnabled ? "Disable" : "Enable", _ when action.StartsWith("Confirm ") => "Confirm", _ => action };
 private string Description => _confirmAction is not null ? "Confirm " + _confirmAction + "?" : _mode == "models" ? "Choose the model used to generate/refine this skill. Your agent's model stays unchanged." : _mode == "skill-install" ? "Browse to a folder containing a skill or a collection of skills, or install from a Git URL or ZIP file." : _mode == "skill-refine" ? "Describe the changes you want. Apply Refinement updates the draft; it does not save or install it." : _mode == "skill-choice" ? "Write the fields yourself, or describe your task and let AI create a draft. Nothing is installed until you choose Save." : _mode == "skill-ai" ? "Describe the task, when to use the skill, and the result you want. Generate Skill creates an editable draft for your review." : _mode == "skill" ? "Instructions are loaded when a request matches the description. Generate/Refine changes only this draft; Save installs it."
  : _mode == "mcp" ? _selected < McpFields.Length ? McpFields[_selected] switch {
   "Arguments" => "One argument per line. Keep an argument containing spaces on a single line; do not add quotes.", "Environment" or "Headers" => "One KEY=value per line. Values are saved in your local configuration.", "Transport" => "Enter toggles between a local stdio process and a remote HTTP server.", "Enabled" => "Off saves the server without starting it.", _ => "Edit this field, then Save & Connect. Testing starts/connects the server without saving it." } : "Test starts/connects this server without saving. Save makes its definition available to all agents."
  : _kind == 1 ? SelectedSkill?.Error ?? SelectedSkill?.Description ?? "Install skills from a Git repository, ZIP archive, or local folder."
  : SelectedRow is { } name && Pane?.Services.GetRequiredService<McpClientManager>().StartupErrors.TryGetValue(name, out var error) == true ? error : "";
