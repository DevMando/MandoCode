@* data-canvas opts into the widget pipeline's Spectre fallback; our middleware
   supplies the cached rich renderable, including code blocks and tool results. *@
@if (Entry.UserPrompt is not null)
{
    <UserPrompt Entry="Entry" />
}
else
{
    <div data-canvas="true" data-transcript-entry="@Entry.Id" />
}

@code {
    [Parameter, EditorRequired] public TuiEntry Entry { get; set; } = default!;
}
