@using RazorConsole.Core.Renderables
@using Spectre.Console
@using RazorConsole.Core.Input
@inject RazorConsole.Core.Focus.FocusManager Focus
@implements IDisposable
<Box FillWidth="true" FillHeight="true" Border="BoxBorder.Rounded" Title="🦙 Ollama Models" BorderColor="@PaneColors.For(Pane, Color.Purple)">
 <Flex Direction="FlexDirection.Column" FillWidth="true" FillHeight="true">
  @if (_tags is null) {
   <Panel Title="Search models by name" Border="BoxBorder.Rounded" BorderColor="@PaneColors.For(Pane, _searchFocused ? Color.DeepSkyBlue1 : Color.Grey50)" Expand="true">
    <div data-focusable="false" @onclick="FocusSearch"><TextArea Buffer="@_search" Editable="@(!_busy)" Width="@Math.Max(1, Width - 8)" Height="1" WordWrap="false" Hook="@_searchKey" OnPreviewKey="SearchKey" OnChanged="SearchChanged" OnSubmit="SearchSubmitted" CharacterStyle="@(_ => new Style(PaneColors.For(Pane, Color.Grey85)))" /></div>
   </Panel>
   <Flex Direction="FlexDirection.Row">
    @foreach (var sort in Controls) { var choice = sort;
     <div data-focusable="false" @onclick="@(() => ChooseSort(choice))"><Markup Content="@(($"{(_sortFocused && Controls[_sortIndex] == choice ? ">" : " ")} {choice} "))" Foreground="@(_sortFocused && Controls[_sortIndex] == choice ? Color.Black : PaneColors.For(Pane, (_sort == choice || choice == "Cloud" && _cloudOnly) ? Color.Green : Color.Grey85))" Background="@(_sortFocused && Controls[_sortIndex] == choice ? Color.DeepSkyBlue1 : new Color(22, 26, 30))" /></div>
    }
   </Flex>
  }
  <div @key="_focusKey" data-focusable="@(Pane is null || Pane.Active)" data-input-managed="true" data-manage-tab="true" @onkeydown="Key">
   <Rows>
    <Markup Content="@Escape(_tags is null ? $"{Matches.Length} models · {_sort}" : "Choose a tag · Enter starts the download")" Foreground="@PaneColors.For(Pane, Color.Grey85)" />
    @if (_busy) {
     <Markup Content="@($"{Frames[_frame % Frames.Length]} Working")" Foreground="@PaneColors.For(Pane, Color.Purple)" />
    }
    @if (!_busy) {
     @TableHeader
     <Markup Content="@(new string('─', TableWidth))" Foreground="@PaneColors.For(Pane, Color.Grey50)" />
     @foreach (var index in Visible) {
      <div data-focusable="false" @onclick="@(() => Select(index))">@TableRow(index)</div>
     }
     @foreach (var line in AgentSettingsDraft.Wrap(Description, Math.Max(1, Width - 4))) { <Markup Content="@Escape(line)" Foreground="@PaneColors.For(Pane, Color.Grey70)" /> }
    }
    @foreach (var line in AgentSettingsDraft.Wrap(_status, Math.Max(1, Width - 4))) { <Markup Content="@Escape(line)" Foreground="@PaneColors.For(Pane, _failed ? Color.Yellow : Color.Green)" /> }
    @if (_busy) {
     <div data-focusable="false" @onclick="CancelOperation"><Markup Content="> Cancel (Enter / Esc)" Foreground="Color.Black" Background="Color.DeepSkyBlue1" /></div>
    } else {
     <Markup Content="@Escape(_tags is null ? "↑/↓ select · Enter tags · Tab search/sort/list · ←/→ sort · Enter apply · Ctrl+P pull name · Ctrl+R refresh · Esc close" : "↑/↓ select · Enter pull · Esc back")" Foreground="@PaneColors.For(Pane, Color.Grey62)" />
    }
   </Rows>
  </div>
  <Box FillHeight="true"><Markup Content=" " /></Box>
 </Flex>
</Box>
@code {
 [CascadingParameter] public AgentPane? Pane { get; set; }
 [CascadingParameter] public ExplorerFocusScope? ExplorerFocus { get; set; }
 [Parameter] public string Endpoint { get; set; } = "http://localhost:11434";
 [Parameter] public int Width { get; set; } = 60;
 [Parameter] public int Height { get; set; } = 24;
 [Parameter] public EventCallback OnClose { get; set; }
 [Parameter] public EventCallback<string> OnDownloaded { get; set; }
 private readonly string _focusKey = "ollama-pull-" + Guid.NewGuid().ToString("N");
 private readonly HttpClient _http = new() { Timeout = Timeout.InfiniteTimeSpan };
 private readonly CancellationTokenSource _shutdown = new();
 private CancellationTokenSource? _operation;
 private IReadOnlyList<OllamaModelLibrary.Model> _models = [];
 private IReadOnlyList<OllamaModelLibrary.Tag>? _tags;
 private string _query = "", _status = "Loading model library", _description = "";
 private int _selected;
 private readonly TextSelectionState _search = new();
 private readonly string _searchKey = "ollama-search-" + Guid.NewGuid().ToString("N");
 private bool _searchFocused, _sortFocused;
 private int _sortIndex = 2;
 private string _sort = "Newest";
 private static readonly string[] Sorts = ["Popular", "Name A–Z", "Newest"];
 private static readonly string[] Controls = ["Popular", "Name A–Z", "Newest", "Cloud"];
 private bool _cloudOnly;
 private IReadOnlyList<OllamaModelLibrary.Model>? _newestModels;
 private bool _busy, _failed, _disposed;
 private int _frame;
 private static readonly string[] Frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
 private OllamaModelLibrary Library => new(_http);
 private OllamaModelLibrary.Model[] Matches => FilterModels(_sort == "Newest" ? _newestModels ?? [] : _models, _query, _sort == "Name A–Z", _cloudOnly);
 internal static OllamaModelLibrary.Model[] FilterModels(IReadOnlyList<OllamaModelLibrary.Model> models, string query, bool alphabetical, bool cloudOnly = false) {
  var matches = models.Where(m => m.Name.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase) && (!cloudOnly || IsCloud(m)));
  return (alphabetical ? matches.OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase) : matches).ToArray();
 }
 internal static bool IsCloud(OllamaModelLibrary.Model model) => model.Capabilities.Split('·', StringSplitOptions.TrimEntries).Contains("cloud", StringComparer.OrdinalIgnoreCase);
 private int TableWidth => Math.Max(1, Width - 4);
 private bool WideTable => _tags is null && TableWidth >= 50;
 private int LastWidth => Math.Min(_tags is null ? 10 : 12, Math.Max(1, TableWidth / 3));
 private int NameWidth => WideTable ? (TableWidth - LastWidth) / 2 : Math.Max(1, TableWidth - LastWidth);
 private RenderFragment Cell(string text, int width, Color color, Color background) => @<Box Width="@width"><Markup Content="@Escape(WorkspaceTabWindow.Fit(text, width))" Foreground="@color" Background="@background" /></Box>;
 private RenderFragment TableHeader => @<Flex Direction="FlexDirection.Row">
  @Cell(_tags is null ? "Model" : "Tag", NameWidth, PaneColors.For(Pane, Color.Purple), Color.Default)
  @if (WideTable) { @Cell("Capabilities", TableWidth - NameWidth - LastWidth, PaneColors.For(Pane, Color.Purple), Color.Default) }
  @Cell(_tags is null ? "Hosting" : "Size", LastWidth, PaneColors.For(Pane, Color.Purple), Color.Default)
 </Flex>;
 private RenderFragment TableRow(int index) => @<Flex Direction="FlexDirection.Row">
  @Cell((RowSelected(index) ? "> " : "  ") + (_tags is null ? Matches[index].Name : _tags[index].Name), NameWidth, RowSelected(index) ? Color.Black : PaneColors.For(Pane, Color.Green), RowSelected(index) ? Color.DeepSkyBlue1 : Color.Default)
  @if (WideTable) { @Cell(string.Join(" · ", Matches[index].Capabilities.Split('·', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Where(capability => !capability.Equals("cloud", StringComparison.OrdinalIgnoreCase))), TableWidth - NameWidth - LastWidth, RowSelected(index) ? Color.Black : PaneColors.For(Pane, Color.Grey85), RowSelected(index) ? Color.DeepSkyBlue1 : Color.Default) }
  @Cell(_tags is null ? IsCloud(Matches[index]) ? "Cloud" : "Local" : _tags[index].Size, LastWidth, RowSelected(index) ? Color.Black : PaneColors.For(Pane, Color.Grey85), RowSelected(index) ? Color.DeepSkyBlue1 : Color.Default)
 </Flex>;
 private bool RowSelected(int index) => !_sortFocused && !_searchFocused && _selected == index;
 private string[] Labels => _tags?.Select(t => t.Name + (t.Size.Length > 0 ? " · " + t.Size : "")).ToArray() ?? Matches.Select(m => m.Name + (m.Capabilities.Length > 0 ? " · " + m.Capabilities : "")).ToArray();
 private string Description => _tags is null ? Matches.ElementAtOrDefault(_selected)?.Description ?? "No matching models. Ctrl+P pulls the name you type." : _description;
 private int PageSize => Math.Max(1, Height - (_tags is null ? 16 : 12) - AgentSettingsDraft.Wrap(Description, Math.Max(1, Width - 4)).Count());
 private IEnumerable<int> Visible => Enumerable.Range(Math.Clamp(_selected - PageSize + 1, 0, Math.Max(0, Labels.Length - PageSize)), Math.Min(PageSize, Labels.Length));
 protected override void OnInitialized() { _ = Animate(); _ = Load(); }
 private Task Load() => Run(async ct => { _newestModels = await Library.Models(ct, newest: true); if (_newestModels.Count == 0) throw new IOException("The library could not be read. Type a model name and press Ctrl+P to pull it."); _status = ""; });
 protected override void OnParametersSet() { if (ExplorerFocus is not null) { ExplorerFocus.NavigateTab = Cycle; ExplorerFocus.FocusExplorer = FocusPanel; } }
 protected override async Task OnAfterRenderAsync(bool firstRender) { if ((Pane is null || Pane.Active) && !Focus.IsFocused(_searchFocused ? _searchKey : _focusKey)) { if (_searchFocused) await FocusSearch(); else await FocusPanel(); } }
 private async Task FocusPanel() { if (Pane is not null && !Pane.Active) return; if (Pane is not null) Pane.FocusKey = _focusKey; ExplorerFocus?.SetPromptFocused(false); await Focus.FocusAsync(_focusKey); }
 private async Task Cycle(bool reverse) {
  if (_busy) return;
  if (_tags is not null) Move(reverse ? -1 : 1);
  else {
   var zone = _searchFocused ? 0 : _sortFocused ? 1 : 2;
   zone = (zone + (reverse ? 2 : 1)) % 3;
   if (zone == 0) await FocusSearch(); else if (zone == 1) await FocusSort(); else await FocusList();
  }
  StateHasChanged();
 }
 private async Task FocusSort() { _searchFocused = false; _sortFocused = true; await FocusPanel(); }
 private async Task ChooseSort(string sort) { if (_busy) return; _sortIndex = Array.IndexOf(Controls, sort); await FocusSort(); await ApplyControl(sort); }
 private async Task FocusList() { _searchFocused = false; _sortFocused = false; await FocusPanel(); }
 private async Task FocusSearch() { _sortFocused = false; _searchFocused = true; if (Pane is not null) Pane.FocusKey = _searchKey; await Focus.FocusAsync(_searchKey); }
 private void SearchChanged() { _query = _search.Text; _selected = 0; StateHasChanged(); }
 private Task SearchSubmitted(string _) => FocusList();
 private async Task<bool> SearchKey(KeyboardEventArgs key) {
  if (Pane is not null && !Pane.Active) return true;
  if ((key.AltKey || key.MetaKey) && Pane?.Workspace.Key(Pane, key) == true) return true;
  if (_busy) { if (key.Key is "Escape" or "Enter") CancelOperation(); return true; }
  if (key.Key == "Tab") { await Cycle(key.ShiftKey); return true; }
  if (key.Key == "ArrowDown") { await FocusSort(); return true; }
  if (key.Key == "Escape") { await FocusList(); return true; }
  if (key.CtrlKey && key.Key.Equals("s", StringComparison.OrdinalIgnoreCase)) { await NextSort(); return true; }
  if (key.CtrlKey && key.Key.Equals("p", StringComparison.OrdinalIgnoreCase)) { await FocusList(); await Download(_query); return true; }
  return false;
 }
 private Task ApplyControl(string control) { if (control != "Cloud") return ChangeSort(control); _cloudOnly = !_cloudOnly; _selected = 0; StateHasChanged(); return Task.CompletedTask; }
 private Task NextSort() => ChangeSort(Sorts[(Array.IndexOf(Sorts, _sort) + 1) % Sorts.Length]);
 private async Task ChangeSort(string sort) {
  if (_busy || _tags is not null) return;
  if (sort == "Newest" && _newestModels is null) {
   _status = "Loading newest models";
   await Run(async ct => { var models = await Library.Models(ct, newest: true); if (models.Count == 0) throw new IOException("The newest model list could not be read."); _newestModels = models; _sort = sort; _selected = 0; _status = ""; });
  } else if (sort != "Newest" && _models.Count == 0) {
   _status = "Loading models";
   await Run(async ct => { var models = await Library.Models(ct); if (models.Count == 0) throw new IOException("The model list could not be read."); _models = models; _sort = sort; _selected = 0; _status = ""; });
  } else { _sort = sort; _selected = 0; }
  StateHasChanged();
 }
 private void Move(int direction) { if (_busy) return; var count = Labels.Length; if (count > 0) _selected = (_selected + direction + count) % count; }
 private async Task Animate() { try { while (!_shutdown.IsCancellationRequested) { await Task.Delay(120, _shutdown.Token); if (_busy) { _frame++; await InvokeAsync(StateHasChanged); } } } catch (OperationCanceledException) { } }
 private static string Escape(string text) => Spectre.Console.Markup.Escape(text);
 private Task Run(Func<CancellationToken, Task> action) {
  if (_busy) return Task.CompletedTask;
  _ = ExecuteRun(action);
  return Task.CompletedTask;
 }
 private void CancelOperation() { if (_operation is null) return; _status = "Cancelling"; _operation.Cancel(); }
 private async Task ExecuteRun(Func<CancellationToken, Task> action) {
  if (_busy) return; _busy = true; _failed = false;
  using var operation = CancellationTokenSource.CreateLinkedTokenSource(_shutdown.Token); _operation = operation;
  try { await action(operation.Token); }
  catch (OperationCanceledException) { _status = "Cancelled. Downloads can be resumed by selecting the same model again."; }
  catch (Exception ex) { _failed = true; _status = ex.Message; }
  finally { _operation = null; _busy = false; if (!_disposed) await InvokeAsync(StateHasChanged); }
 }
 private async Task Select(int index) {
  if (_busy) return; _searchFocused = false; _sortFocused = false; _selected = index;
  if (_tags is not null) { if (_tags.ElementAtOrDefault(index) is { } tag) await Download(tag.Name); return; }
  if (Matches.ElementAtOrDefault(index) is not { } model) return;
  _status = "Loading tags"; _description = model.Description;
  await Run(async ct => { var tags = await Library.Tags(model.Name, ct); if (tags.Count == 0) throw new IOException("No tags found. Type the model:tag and press Ctrl+P instead."); _tags = tags; _selected = 0; _status = ""; });
 }
 private async Task Download(string name) {
  if (string.IsNullOrWhiteSpace(name)) return;
  _status = "Starting download: " + name;
  await Run(async ct => { await Library.Pull(Endpoint, name.Trim(), p => { _status = p.Status + (p.Total > 0 ? $" · {Math.Clamp(p.Completed * 100d / p.Total, 0, 100):F0}% · {p.Completed / 1048576d:F1}/{p.Total / 1048576d:F1} MiB" : ""); if (!_disposed) _ = InvokeAsync(StateHasChanged); }, ct); _status = name + " downloaded. Select it with /model when ready."; if (OnDownloaded.HasDelegate) await InvokeAsync(() => OnDownloaded.InvokeAsync(name.Trim())); });
 }
 private async Task Key(KeyboardEventArgs key) {
  if (Pane is not null && !Pane.Active) return;
  if ((key.AltKey || key.MetaKey) && Pane?.Workspace.Key(Pane, key) == true) return;
  if (key.Key == "Escape") { if (_busy) CancelOperation(); else if (_tags is not null) { _tags = null; _selected = 0; } else await OnClose.InvokeAsync(); return; }
  if (_busy) { if (key.Key == "Enter") CancelOperation(); return; }
  if (_sortFocused) {
   if (key.Key == "Tab") await Cycle(key.ShiftKey);
   else if (key.Key is "ArrowLeft" or "ArrowRight") _sortIndex = (_sortIndex + (key.Key == "ArrowLeft" ? Controls.Length - 1 : 1)) % Controls.Length;
   else if (key.Key == "ArrowUp") await FocusSearch();
   else if (key.Key == "ArrowDown") await FocusList();
   else if (key.Key == "Enter") await ApplyControl(Controls[_sortIndex]);
   return;
  }
  if (key.Key == "Tab") { await Cycle(key.ShiftKey); }
  else if (key.Key is "ArrowUp" or "ArrowDown") { Move(key.Key == "ArrowUp" || key.ShiftKey ? -1 : 1); }
  else if (key.CtrlKey && key.Key.Equals("s", StringComparison.OrdinalIgnoreCase)) await NextSort();
  else if (key.Key == "Enter") await Select(_selected);
  else if (key.CtrlKey && key.Key.Equals("p", StringComparison.OrdinalIgnoreCase)) await Download(_query);
  else if (key.CtrlKey && key.Key.Equals("r", StringComparison.OrdinalIgnoreCase)) { _status = "Loading model library"; await Run(async ct => { _models = await Library.Models(ct); if (_sort == "Newest") _newestModels = await Library.Models(ct, newest: true); _selected = 0; _status = ""; }); }
  else if (_tags is null && !key.CtrlKey && !key.AltKey) { if (key.Key == "Backspace" && _query.Length > 0) _query = _query[..^1]; else if (key.Key.Length == 1) _query += key.Key; _search.SetText(_query); _selected = 0; }
 }
 public void Dispose() { _disposed = true; if (ExplorerFocus?.NavigateTab == Cycle) ExplorerFocus.NavigateTab = null; if (ExplorerFocus?.FocusExplorer == FocusPanel) ExplorerFocus.FocusExplorer = null; _shutdown.Cancel(); _http.Dispose(); _shutdown.Dispose(); }
}
