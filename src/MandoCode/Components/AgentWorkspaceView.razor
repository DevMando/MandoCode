@using RazorConsole.Core.Renderables
@using Spectre.Console
@inject AgentWorkspace Workspace
@inject RazorConsole.Core.Rendering.ITerminalViewport Viewport
@inject RazorConsole.Core.Focus.FocusManager Focus
@implements IDisposable

<Flex Direction="@(SplitRowsSideBySide ? FlexDirection.Column : FlexDirection.Row)" FillWidth="true" FillHeight="true">
    <AgentGridRow Row="0" RowWidth="@RowWidth" PaneWidth="@PaneWidth" PaneHeight="@PaneHeight" AgentBody="AgentBody" Revision="@Workspace.Revision" />
    <AgentGridRow Row="1" RowWidth="@RowWidth" PaneWidth="@PaneWidth" PaneHeight="@PaneHeight" AgentBody="AgentBody" Revision="@Workspace.Revision" />
</Flex>
@code {
    [Parameter] public RenderFragment<AgentPane>? AgentBody { get; set; }
    private int RowWidth => SplitRowsSideBySide ? Viewport.Width : PaneWidth;
    private long _lastFocusVersion = -1;
    private bool SplitRowsSideBySide => Workspace.Panes.Count == 2 && Workspace.Panes.Select(p => AgentWorkspace.Column(p.Slot)).Distinct().Count() == 1;
    private int PaneWidth => Math.Max(1, Viewport.Width / (Workspace.Panes.Count > 1 ? 2 : 1));
    private int PaneHeight => Math.Max(1, Viewport.Height / (Workspace.Panes.Count > 2 ? 2 : 1));
    protected override void OnInitialized()
    {
        Workspace.Changed += Changed;
        Viewport.OnResized += Changed;
        if (Workspace.Panes.Count == 0) Workspace.Add();
        UpdateSizes();
    }
    private void UpdateSizes()
    {
        foreach (var pane in Workspace.Panes)
        {
            pane.Width = Math.Max(1, PaneWidth - (Workspace.Panes.Count > 1 ? 2 : 0));
            pane.Height = Math.Max(1, Workspace.Panes.Count == 3 && Workspace.Panes.Count(p => AgentWorkspace.Column(p.Slot) == AgentWorkspace.Column(pane.Slot)) == 1
                ? Viewport.Height - 3 : PaneHeight - (Workspace.Panes.Count > 1 ? 3 : 1));
        }
    }
    private void Changed() => _ = InvokeAsync(() => { UpdateSizes(); StateHasChanged(); });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        UpdateSizes();
        var active = Workspace.Panes.FirstOrDefault(p => p.Active);
        if (_lastFocusVersion != Workspace.FocusVersion && active?.FocusKey is { } key)
        {
            _lastFocusVersion = Workspace.FocusVersion;
            await Focus.FocusAsync(key);
        }
    }
    public void Dispose() { Workspace.Changed -= Changed; Viewport.OnResized -= Changed; }
}
