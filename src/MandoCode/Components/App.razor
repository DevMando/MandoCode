    private void CompleteDirectorySelection(string? path) => _directorySelection?.TrySetResult(path);
    private async Task RunInteractiveLoopAsync()
    {
        using var output = Pane is null ? null : TuiConsole.Enter(Pane.Session);
        if (_offerStartupModelPicker)
        {
            _offerStartupModelPicker = false;
            _isProcessing = true;
            try { await HandleModelCommandAsync(); }
            catch (Exception ex)
            {
                AnsiConsole.WriteLine($"Could not select a replacement model: {ex.Message}");
            }
        }
        while (true)
        {
            // Ensure music visualizer is running if music is active
            // (it writes to a fixed upper-right screen position via ANSI escapes, no prompt conflict)
            StartMusicVisualizer();

            // Await user input via VDOM PromptInput component.
            var input = await WaitForVdomInputAsync();
            if (_paneStopped) return;
            var peerRequest = _peerRequest;
            _peerRequest = null;
            using var callChain = Pane is null ? null : CliAgentCallChain.Enter(Pane.PersistKey, peerRequest?.Chain, peerRequest?.Kind == "review");

            if (peerRequest is not null)
            {
                _runningPeerRequest = peerRequest;
                using var peerTranscript = Pane!.Session.CaptureAgentExchange(peerRequest.InteractionId, peerRequest.From);
                try
                {
                    input = Delegations.WithInbox(Pane!.PersistKey, input);
                    _messages.Add(new ChatMsg { Role = "user", Text = input });
                    var before = _messages.Count;
                    await ProcessDirectRequestAsync(input, cancellationToken: peerRequest.Cancellation);
                    var answer = _lastCompletedReply ?? string.Join("\n", _messages.Skip(before).Where(m => m.Role == "assistant").Select(m => m.Text));
                    var outcome = _lastRequestError is not null ? new CliPeerAnswer(false, _lastRequestError) :
                        string.IsNullOrWhiteSpace(answer) ? new(false, "The model returned no answer.") : new(true, answer);
                    Pane?.Session.AppendAgentDetail(peerRequest.InteractionId, $"{CliAgentPresentation.PlainName(peerRequest.From)} · Request from", new Spectre.Console.Text(outcome.Answered ? "Response delivered to the requesting agent." : outcome.Text, new Spectre.Console.Style(outcome.Answered ? Spectre.Console.Color.Green : Spectre.Console.Color.Yellow)), outcome.Answered ? "Completed" : "Failed", problem: !outcome.Answered);
                    peerRequest.Completion.TrySetResult(outcome);
                }
                catch (Exception ex)
                {
                    Pane!.Session.AppendAgentDetail(peerRequest.InteractionId, $"{CliAgentPresentation.PlainName(peerRequest.From)} · Request", new Spectre.Console.Text(ex.Message), "Failed", problem: true);
                    peerRequest.Completion.TrySetResult(new(false, ex.Message));
                }
                finally { _runningPeerRequest = null; }
                continue;
            }

            if (string.IsNullOrWhiteSpace(input))
                continue;

            // Shell escape: !<cmd> runs a shell command inline
            if (input.TrimStart().StartsWith('!'))
            {
                await Shell.HandleShellCommandAsync(input.TrimStart()[1..].Trim());
                continue;
            }

            if (InputStateMachine.IsCommand(input))
            {
                if (await ExecuteSlashCommandAsync(input) == CliCommandResult.Exit) return;
                continue;
            }

            if (!_isConnected)
            {
                await HandleRetryCommandAsync();
                if (!_isConnected) continue;
            }

            // Block AI requests when model is not available
            if (_modelError)
            {
                AnsiConsole.MarkupLine("[yellow]No model loaded.[/] Run [deepskyblue1]/config[/] to select a model, or pull one with [deepskyblue1]ollama pull <model-name>[/].");
                AnsiConsole.WriteLine();
                continue;
            }

            // Matrix easter egg: play a cinematic moment for trigger phrases
            if (ContainsMatrixTrigger(input))
            {
                PlayMatrixMoment(input);
            }

            // Process @file references and inject file content
            var processedInput = ProcessFileReferences(input);
            if (Pane is not null) processedInput += new CliAgentDirectory(Pane).ExpandMentions(input)[input.Length..];
            if (Pane is not null) processedInput = Delegations.WithInbox(Pane.PersistKey, processedInput);

            // Add user message to chat history
            _messages.Add(new ChatMsg { Role = "user", Text = input });

            var requestWithContext = Snapshots.WithImports(processedInput);
            try { await ProcessDirectRequestAsync(requestWithContext); }
            finally
            {
                // A failed provider request can still leave its user message in AI history.
                // Once accepted into history, the context is already there for the retry.
                if (Snapshots.QueuedCount > 0 && (await AI.GetHistoryAsync()).Any(m =>
                    m.Role == Microsoft.Extensions.AI.ChatRole.User && m.Text == requestWithContext))
                    Snapshots.ClearImports();
            }
        }
    }

