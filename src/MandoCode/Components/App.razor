    // Room for the menu's options, the panel's borders and footer, and the question above it.
    private static int ApprovalPreviewPageSize
    {
        get
        {
            try { return Math.Clamp(Console.WindowHeight - 16, 6, 30); }
            catch { return 20; }
        }
    }

    private void HandleApprovalPreviewScroll(ApprovalSelect.ScrollKey key)
    {
        var count = ApprovalMenu.Preview.Count;
        if (count == 0) return;

        var page = ApprovalPreviewPageSize;
        var max = Math.Max(0, count - page);
        _approvalPreviewOffset = key switch
        {
            ApprovalSelect.ScrollKey.PageUp => Math.Max(0, _approvalPreviewOffset - page),
            ApprovalSelect.ScrollKey.PageDown => Math.Min(max, _approvalPreviewOffset + page),
            ApprovalSelect.ScrollKey.Home => 0,
            _ => max,
        };
        StateHasChanged();
    }

