    private async Task HandleUpdateCommandAsync()
    {
        var updater = ToolUpdater;
        if (!updater.TryBegin())
        {
            AnsiConsole.MarkupLine("[yellow]An update is already being checked or prepared.[/]");
            return;
        }
        AgentPane[] GetAgents() => (Pane?.Workspace.Registry?.Workspaces.SelectMany(w => w.Panes)
            ?? Pane?.Workspace.Panes ?? Array.Empty<AgentPane>()).ToArray();
        var agents = GetAgents();
        bool OtherAgentBusy() => agents.Any(agent => agent != Pane && agent.IsBusy?.Invoke() == true);
        _isProcessing = true;
        try
        {
            if (OtherAgentBusy())
            {
                AnsiConsole.MarkupLine("[yellow]Finish work and close menus in other agents before updating. /update closes all workspaces.[/]");
                return;
            }
            Spinner.Start("Checking for updates");
            UpdateInfo? update;
            try
            {
                var problem = await updater.CheckInstallationAsync();
                if (problem is not null) { AnsiConsole.WriteLine(problem); return; }
                update = await UpdateCheck.CheckForUpdateAsync(force: true);
            }
            finally { Spinner.Stop(); }
            if (update is null)
            {
                AnsiConsole.MarkupLine("[green]MandoCode is already on the latest stable release.[/]");
                return;
            }
            var persistenceNote = agents.Any(agent => !agent.Services.GetRequiredService<MandoCodeConfig>().AllowPersistence)
                ? " History saving is disabled for some agents; their conversations will not be saved."
                : " Agent histories will be saved.";
            if (!await WizardConfirmAsync($"Update to {update.LatestVersion}? MandoCode will close all workspaces.{persistenceNote}", false)) return;
            agents = GetAgents();
            if (OtherAgentBusy())
            {
                AnsiConsole.MarkupLine("[yellow]Another agent started working. Finish its work before updating.[/]");
                return;
            }
            if (agents.Any(agent => agent.SaveHistory?.Invoke(false) == false))
            {
                AnsiConsole.MarkupLine("[yellow]Update cancelled because an agent history could not be saved.[/]");
                return;
            }
            updater.Prepare(update.LatestVersion);
            Lifetime.StopApplication();
        }
        catch (Exception ex)
        {
            AnsiConsole.WriteLine("Could not prepare the update: " + ex.Message);
            AnsiConsole.WriteLine("Run manually: dotnet tool update -g MandoCode");
        }
        finally { Spinner.Stop(); updater.End(); _isProcessing = false; }
    }

    private DateTimeOffset? _archiveClosedAt;
    private bool SaveAgentHistory(bool closed)
    {
        if (Pane is null || !Config.AllowPersistence || _messages.Count == 0) return true;
        var store = Pane.Services.GetRequiredService<AgentArchiveStore>();
        try
        {
            Pane.ArchiveLease ??= store.Claim(Pane.PersistKey);
            if (Pane.ArchiveLease is null) throw new IOException(store.Error);
            var archive = new ArchivedAgent(Pane.PersistKey, Pane.Name, ProjectRoot.ProjectRoot, Pane.Workspace.Name,
                closed ? _archiveClosedAt ?? DateTimeOffset.Now : _archiveClosedAt,
                new(Config.GetEffectiveModelName(), Config.Temperature, Config.MaxTokens, Config.ContextLength) { OllamaEndpoint = Config.OllamaEndpoint, ContextLengthSetByUser = Config.ContextLengthSetByUser, AgentOptions = AgentSettingsDraft.Capture(Config) },
                _messages.ToList(), AgentArchiveStore.Capture(Pane.Session), AI.ExportHistoryJson(),
                TokenTracker.TotalPromptTokens, TokenTracker.TotalCompletionTokens, TokenTracker.LastOperation) { MessageCount = _messages.Count };
            if (!store.Save(archive)) throw new IOException(store.Error);
            if (closed) _archiveClosedAt = archive.ClosedAt;
            return true;
        }
        catch (Exception ex)
        {
            Pane.Session.Append(new Text("Agent history could not be saved. " + ex.Message, new Style(Color.Yellow)));
            return false;
        }
    }
    private void RestoreAgentHistory()
    {
        if (Pane?.RestoreFrom is not { } archive) return;
        using var output = TuiConsole.Enter(Pane.Session);
        AgentArchiveStore.Replay(archive, Pane.Session);
        _messages.AddRange(archive.Messages);
        TokenTracker.Restore(archive.PromptTokens, archive.CompletionTokens, archive.LastUsage);
        var restored = archive.HistoryJson is null ? 0 : AI.TryRestoreHistoryJson(archive.HistoryJson);
        if (restored == 0)
        {
            var recent = string.Join("\n\n", archive.Messages.TakeLast(20).Select(m => $"{m.Role}: {m.Text}"));
            if (recent.Length > 12000) recent = recent[^12000..];
            AI.AppendUserNote("Restored conversation excerpt (full model memory was unavailable):\n" + recent);
            AnsiConsole.MarkupLine("[yellow]Transcript restored; recent conversation will be re-briefed to the agent.[/]");
        }
        else AnsiConsole.MarkupLine("[green]Agent restored with conversation context.[/]");
        if (!Directory.Exists(archive.ProjectRoot))
        {
            AI.AppendUserNote($"Original project directory {archive.ProjectRoot} is unavailable. Current directory is {ProjectRoot.ProjectRoot}; re-read files before working.");
            AnsiConsole.MarkupLine("[yellow]Original folder unavailable. Using the current project; /change-directory selects another folder.[/]");
        }
        var store = Pane.Services.GetRequiredService<AgentArchiveStore>();
        if (!store.MarkOpen(archive)) AnsiConsole.MarkupLine("[yellow]Restored agent, but its archive entry could not be updated.[/]");
        Pane.RestoreFrom = null;
    }

