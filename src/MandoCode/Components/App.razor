    /// <summary>
    /// Show a single-line text prompt rendered through RazorConsole's TextInput component.
    /// Avoids Spectre's TextPrompt entirely so there's no Console.ReadLine vs VDOM render-loop
    /// conflict. Optional <paramref name="validate"/> returns null on success, an error message
    /// on failure — failure prints the error and re-prompts.
    /// </summary>
    private Task<string> WizardPromptTextAsync(string title, string placeholder = "", Func<string, string?>? validate = null, string? initialValue = null) =>
        WizardPromptTextCoreAsync(title, placeholder, validate, initialValue, false);

    private async Task<string> WizardPromptTextCoreAsync(string title, string placeholder, Func<string, string?>? validate, string? initialValue, bool secret)
    {
        var restorePrompt = _showPrompt;
        _wizardInputSecret = secret;
        try
        {
            while (true)
            {
                // Render the title as a separate scrollback line above the input box so it
                // persists after the input is dismissed.
                AnsiConsole.MarkupLine($"[deepskyblue1]{Spectre.Console.Markup.Escape(title)}[/]");

                // Pre-fill with initialValue when provided (e.g., default URL for endpoint
                // entry — user can press Enter to accept or edit in place). Empty otherwise,
                // and the placeholder hint shows in greyed text until the user types.
                _wizardInputValue = initialValue ?? "";
                _wizardInputPlaceholder = placeholder;
                // Async continuations so the awaiting wizard step resumes off the dispatcher
                // thread (HandleWizardInputSubmit completes this from a Blazor event). See the
                // note in WaitForVdomInputAsync.
                _wizardInputTcs = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
                _showWizardInput = true;
                _showPrompt = false;
                await InvokeAsync(StateHasChanged);

                var result = await _wizardInputTcs.Task;

                _showWizardInput = false;
                await InvokeAsync(StateHasChanged);
                // Brief wait so the VDOM tears down the input before we Console.Write the gold echo.
                await Task.Delay(50);

                if (validate != null)
                {
                    var error = validate(result);
                    if (error != null)
                    {
                        AnsiConsole.MarkupLine($"[red]{Spectre.Console.Markup.Escape(error)}[/]");
                        AnsiConsole.WriteLine();
                        continue;
                    }
                }

                // Persist the answer in scrollback (matches the > gold echo pattern in the main loop).
                Console.WriteLine($"\u001b[38;2;255;200;80m> {(secret ? "[hidden]" : result)}\u001b[0m");
                return result;
            }
        }
        finally
        {
            _showWizardInput = false;
            _wizardInputTcs = null;
            _wizardInputSecret = false;
            _showPrompt = restorePrompt;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Show a list of options rendered through the focused approval component. User navigates
    /// with arrow keys and commits with Enter. Returns the selected option string.
    /// </summary>
    private Task<string> WizardPromptSelectAsync(string title, params string[] options) =>
        WizardPromptSelectCoreAsync(title, options);

    private async Task<string> WizardPromptSelectCoreAsync(string title, string[] options, string? silentChoice = null, bool liveTitle = false)
    {
        if (options.Length == 0) throw new ArgumentException("At least one option required", nameof(options));

        // Cancellable navigation menus show the title only in the live region.
        // Persist it together with the choice only after the user commits an action.
        _wizardSelectTitle = silentChoice is not null || liveTitle ? title : null;
        if (silentChoice is null && !liveTitle)
            AnsiConsole.MarkupLine($"[deepskyblue1]{Spectre.Console.Markup.Escape(title)}[/]");

        _wizardSelectChoices = options.Select(option => new ApprovalSelect.Option(option, Color.DeepSkyBlue1)).ToArray();
        // Async continuations so the awaiting wizard step resumes off the dispatcher
        // thread (HandleWizardSelectSubmit completes this from a Blazor event). See the
        // note in WaitForVdomInputAsync.
        _wizardSelectTcs = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
        var restorePrompt = _showPrompt;
        _showWizardSelect = true;
        _showPrompt = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await _wizardSelectTcs.Task;
            if (result != silentChoice)
            {
                if (silentChoice is not null)
                    AnsiConsole.MarkupLine($"[deepskyblue1]{Spectre.Console.Markup.Escape(title)}[/]");
                AnsiConsole.Write(new Text("> " + result, new Style(new Color(255, 200, 80))));
            }
            return result;
        }
        finally
        {
            _showWizardSelect = false;
            _wizardSelectTcs = null;
            _wizardSelectChoices = Array.Empty<ApprovalSelect.Option>();
            _wizardSelectTitle = null;
            _showPrompt = restorePrompt;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Convenience: yes/no confirm rendered as a component selector. Used by wizards
    /// instead of <c>AnsiConsole.Confirm</c> so the entire flow stays inside the VDOM render
    /// pipeline.
    /// </summary>
    private async Task<bool> WizardConfirmAsync(string title, bool defaultYes = false)
    {
        var yes = "Yes";
        var no = "No";
        var options = defaultYes ? new[] { yes, no } : new[] { no, yes };
        var picked = await WizardPromptSelectAsync(title, options);
        return picked == yes;
    }

    /// <summary>
    /// Shows the VDOM PromptInput component and awaits user submission.
    /// Returns the submitted text without blocking the Blazor render thread.
    /// The prompt stays visible but disabled during processing — this avoids
    /// border artifacts that occur when the component is removed from the VDOM tree.
    /// </summary>
    private async Task<string> WaitForVdomInputAsync()
    {
        // RunContinuationsAsynchronously is critical: HandleVdomSubmit completes this TCS
        // from the Blazor dispatcher thread. Without it, the awaiting continuation (the rest
        // of the interactive loop — blocking Spectre prompts, guarded renders, Spinner.Stop's
        // task.Wait) would resume inline ON the dispatcher and freeze the UI. Mirrors
        // InstructionPromptCoordinator, which already uses this for the same reason.
        _inputTcs = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
        _promptInitialValue = "";
        _showPrompt = true;
        _isProcessing = false;
        await InvokeAsync(StateHasChanged);

        var input = await _inputTcs.Task;
        if (_paneStopped) return string.Empty;

        _showPrompt = true;
        _isProcessing = true;
        await InvokeAsync(StateHasChanged);

        return input;
    }

    // Total-budget cap across all @file/@dir expansions in one message. Individual files
    // are capped at 10k chars each, but many @refs combined can still blow the context
    // before the chat call even starts. At this size (~60k chars ≈ 15k tokens) we stop
    // expanding further references and append a notice.
    private const int MaxFileReferenceBudgetChars = 60_000;

    private void ShowOfflineGuidance()
    {
        var endpoint = Spectre.Console.Markup.Escape(Config.OllamaEndpoint);
        AnsiConsole.WriteLine();
        AnsiConsole.MarkupLine($"[yellow]MandoCode can't reach Ollama at {endpoint}.[/]");
        AnsiConsole.MarkupLine("[dim]Run /retry to reconnect, /ollama-serve to start local Ollama, or /setup to check the server URL. You can also run 'ollama serve' in another terminal.[/]");
        AnsiConsole.WriteLine();
    }

    /// <summary>
    /// Starts a background task that listens for Escape key presses and cancels _requestCts.
    /// Call StopCancelKeyListener() when the AI request completes to clean up.
    /// </summary>
    private void StartCancelKeyListener()
    {
        if (TuiConsole.Current is not null) return;
        var listenerCts = new CancellationTokenSource();
        _keyListenerCts = listenerCts;

        Task.Run(async () =>
        {
            try
            {
                while (!listenerCts.Token.IsCancellationRequested)
                {
                    // Skip ReadKey while a Spectre prompt owns the console — otherwise
                    // we race the prompt's own reader and silently drop arrow keys.
                    if (!KeyCoordinator.Suppressed && Console.KeyAvailable)
                    {
                        var key = Console.ReadKey(intercept: true);
                        if (key.Key == ConsoleKey.Escape)
                        {
                            var cts = _requestCts;
                            if (cts != null && !cts.IsCancellationRequested)
                            {
                                cts.Cancel();
                            }
                            break;
                        }
                    }
                    await Task.Delay(50, listenerCts.Token);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    /// <summary>
    /// Stops the background Escape key listener.
    /// </summary>
    private void StopCancelKeyListener()
    {
        var cts = Interlocked.Exchange(ref _keyListenerCts, null);
        if (cts != null)
        {
            cts.Cancel();
            cts.Dispose();
        }
    }

    private void HandleCopyCommand()
    {
        if (string.IsNullOrEmpty(_lastAiResponse))
        {
            AnsiConsole.MarkupLine("[yellow]Nothing to copy — no AI response yet.[/]");
            AnsiConsole.WriteLine();
            return;
        }

        // OSC 52: copy to system clipboard via terminal escape code
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_lastAiResponse));
        TuiConsole.WriteTerminalControl($"\u001b]52;c;{base64}\u0007");

        AnsiConsole.MarkupLine($"[green]Copied to clipboard[/] [dim]({_lastAiResponse.Length} chars)[/]");
        AnsiConsole.WriteLine();
    }

    private void HandleCopyCodeCommand()
    {
        if (string.IsNullOrEmpty(_lastAiResponse))
        {
            AnsiConsole.MarkupLine("[yellow]Nothing to copy — no AI response yet.[/]");
            AnsiConsole.WriteLine();
            return;
        }

        // Extract fenced code blocks
        var codeBlockPattern = @"```(?:\w*)\r?\n([\s\S]*?)```";
        var matches = Regex.Matches(_lastAiResponse, codeBlockPattern);

        if (matches.Count == 0)
        {
            AnsiConsole.MarkupLine("[yellow]No code blocks found in the last response.[/]");
            AnsiConsole.WriteLine();
            return;
        }

        var codeContent = string.Join("\n\n", matches.Cast<Match>().Select(m => m.Groups[1].Value.TrimEnd()));

        // OSC 52 has a practical payload limit (~74,994 bytes base64)
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(codeContent));
        if (base64.Length > 74_994)
        {
            // Truncate to fit
            var maxBytes = 74_994 * 3 / 4; // approximate raw byte limit
            codeContent = codeContent[..Math.Min(codeContent.Length, maxBytes)];
            base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(codeContent));
            AnsiConsole.MarkupLine("[yellow]Warning: Code blocks truncated to fit clipboard limit.[/]");
        }

        TuiConsole.WriteTerminalControl($"\u001b]52;c;{base64}\u0007");

        AnsiConsole.MarkupLine($"[green]Copied {matches.Count} code block(s) to clipboard[/] [dim]({codeContent.Length} chars)[/]");
        AnsiConsole.WriteLine();
    }

    private async Task HandleRetryCommandAsync()
    {
        AnsiConsole.WriteLine();
        var probe = await RecoverOllamaConnectionAsync();
        _isConnected = probe.Ok;

        if (probe.Ok)
        {
            AnsiConsole.MarkupLine("[green]✓ Connected to Ollama![/]");
            await ValidateCurrentModelAsync();
        }
        else
        {
            AnsiConsole.WriteLine(probe.Error ?? "Ollama is still unavailable.");
            ShowOfflineGuidance();
        }

        AnsiConsole.WriteLine();
        await InvokeAsync(StateHasChanged);
    }

    private async Task<OllamaSetupHelper.ProbeResult> RecoverOllamaConnectionAsync()
    {
        var processing = _isProcessing;
        _isProcessing = true;
        Spinner.Start(message: "Checking Ollama connection");
        await InvokeAsync(StateHasChanged);
        try
        {
            var recovery = (Pane?.Services ?? Services).GetRequiredService<OllamaConnectionRecovery>();
            var probe = await recovery.RecoverAsync(Config.OllamaEndpoint, Config.ContextLength,
                message => Spinner.Start(message: message), _requestCts?.Token ?? Lifetime.ApplicationStopping);
            if (probe.WasHealed)
            {
                Config.OllamaEndpoint = probe.NormalizedUrl;
                Config.Save();
                await AI.ReinitializeAsync(Config);
            }
            return probe;
        }
        catch (OperationCanceledException) { return new(false, Config.OllamaEndpoint, false, "Ollama recovery cancelled."); }
        finally { Spinner.Stop(); _isProcessing = processing; await InvokeAsync(StateHasChanged); }
    }

    private static bool IsOllamaTransportFailure(Exception error)
    {
        for (Exception? current = error; current is not null; current = current.InnerException)
            if (current is System.Net.Http.HttpRequestException { StatusCode: null } or System.Net.Sockets.SocketException) return true;
        return false;
    }

    private async Task HandleConfigCommandAsync()
    {
        AnsiConsole.WriteLine();
        var prompts = new ConfigurationPrompts
        {
            Select = (title, options) => WizardPromptSelectAsync(title, options),
            PickModel = PickModelFromPromptAsync,
            Text = (title, initial, validate, secret) => WizardPromptTextCoreAsync(title, "", validate, initial, secret)
        };
        var choice = await WizardPromptSelectCoreAsync("Configuration Options:", new[]
        {
            "Run configuration wizard", "View current configuration", "Agent naming", "Cancel"
        }, silentChoice: "Cancel");

        switch (choice)
        {
            case "Run configuration wizard":
                await CaptureSnapshot();
                var updatedConfig = await ConfigurationWizard.RunAsync(
                    Config,
                    prompts: prompts);
                var configuredAgents = Pane is null ? new[] { Config } :
                    (Pane.Workspace.Registry?.Workspaces.SelectMany(w => w.Panes) ?? Pane.Workspace.Panes)
                        .Select(p => p.Services.GetRequiredService<MandoCodeConfig>());
                var defaults = ModelDefaults;
                defaults.UpdateSettings(updatedConfig, configuredAgents);
                defaults.UpdateSetting("model", updatedConfig.GetEffectiveModelName(), configuredAgents);
                await AI.ReinitializeAsync(updatedConfig);
                if (Snapshots.Pending is not null) await ShowSnapshots(false, true);
                TuiConsole.Clear();
                AnsiConsole.WriteLine($"✓ Configuration updated! Now using model: {updatedConfig.GetEffectiveModelName()}\n");

                // Re-validate the model after config change
                var (isValid, errorMessage) = await AI.ValidateModelAsync();
                if (isValid)
                {
                    if (_modelError)
                    {
                        _modelError = false;
                        _modelWarning = null;
                        AnsiConsole.MarkupLine("[green]✓ Model validated successfully! You can now use MandoCode.[/]");
                        AnsiConsole.WriteLine();
                    }
                }
                else
                {
                    _modelError = true;
                    _modelWarning = errorMessage;
                    AnsiConsole.MarkupLine($"[yellow]Warning:[/] {errorMessage}");
                    AnsiConsole.MarkupLine("[dim]Pull the model or run /config again to select a different one.[/]");
                    AnsiConsole.WriteLine();
                }
                break;

            case "Agent naming":
                var naming = await WizardPromptSelectCoreAsync($"Agent naming (current: {(Config.UseAgentNames ? "Names" : "Numbers")}; applies to new agents, existing names stay unchanged):",
                    new[] { "Names (default): unique callsigns such as Neo or Kernel, like Desktop", "Numbers: sequential labels such as Agent 1 or Agent 2; reuse available numbers", "Cancel" }, silentChoice: "Cancel");
                if (naming != "Cancel")
                    await HandleConfigSetCommandAsync("agentNaming " + (naming.StartsWith("Names", StringComparison.Ordinal) ? "names" : "numbers"));
                break;

            case "View current configuration":
                AnsiConsole.WriteLine();
                Config.Display();
                AnsiConsole.WriteLine();
                break;
        }
    }

