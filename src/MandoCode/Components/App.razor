@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection
@using MandoCode.Models
@using MandoCode.Services
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using Spectre.Console

@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime Lifetime
@implements IDisposable
@implements IAsyncDisposable

@if (Pane is null || Pane.Visible)
{
<ChatShell
    SnapshotsOpen="@_snapshotsOpen"
    SnapshotCreate="@_snapshotCreate"
    SnapshotOffer="@_snapshotOffer"
    SnapshotContext="@Snapshots"
    OnSnapshotsClose="CloseSnapshots"
    OnSnapshotCapture="CaptureSnapshot"
    OnSnapshotKeepMemory="KeepSnapshotMemory"
    SetupOpen="@_setupOpen"
    OnSetupComplete="SetupComplete"
    OllamaPullOpen="@_ollamaPullOpen"
    OllamaEndpoint="@Config.OllamaEndpoint"
    OnOllamaPullClose="CloseOllamaPull"
    IntegrationsOpen="@_integrationsOpen"
    IntegrationCoordinator="@(IntegrationCoordinator)"
    IntegrationKind="@_integrationKind"
    OnIntegrationsClose="CloseIntegrations"
    OnManageIntegrations="ManageIntegrations"
    SettingsOpen="@_settingsOpen"
    SettingsConfig="@Config"
    OnSettingsClose="CloseSettings"
    OnSettingsSave="SaveAgentSettings"
    OnApplyDefaults="ApplyAgentDefaults"
    OnSaveDefaults="SaveAgentDefaults"
    OnSettingsModel="SettingsModel"
    SettingsModelPicker="@_modelPicker"
    OnSettingsModelSelected="HandleModelSelected"
    OnSettingsModelCancel="CancelModelPicker"
    @ref="_chatShell"
    ProjectDirectory="@ProjectRoot.ProjectRoot"
    DirectoryBrowserOpen="@_directoryBrowserOpen"
    OnDirectoryChosen="CompleteDirectorySelection"
    FileExplorerOpen="@_fileExplorerOpen"
    OnFileExplorerClose="CloseFileExplorer"
    OnFileExplorerToggle="ToggleFileExplorer"
    GitChangesOpen="@_gitChangesOpen"
    OnGitChangesClose="CloseGitChanges"
    OnGitDiscarded="GitDiscarded"
    HistoryOpen="@_historyActive"
    OnHistoryClose="CloseHistory"
    OnHistoryRestore="RestoreArchivedAgent"
    OnChangeDirectory="@(() => HandleVdomSubmit("/change-directory"))">
<Header>
<Banner />

@* Keep the banner visible, but hide startup details while setup owns the screen.
   HomeView keeps that visibility rule together instead of repeating it for each detail. *@
@if (!_setupActive)
{
    <HomeView
              SupportsVision="@AI.SupportsImageInput"
              OllamaEndpoint="@Config.OllamaEndpoint"
              ConnectionChecked="@_connectionChecked"
              IsConnected="@_isConnected"
              OnboardingStatus="@_onboardingStatus"
              ModelWarning="@_modelWarning"
              UpdateNotice="@_updateNotice"
              UpdateCommand="@_updateCommand" />
}

</Header>
<Footer>
@if (Pane?.Workspace.Registry?.IsWorkspacePickerOpen != true)
{
@* VDOM input — always rendered once interactive loop starts, disabled during processing.
   Hidden while an instruction prompt is active so the two text inputs don't fight for focus. *@
@if (_showPrompt && !_presentation.HidesChatPrompt && !InstructionCoordinator.IsActive && !ApprovalMenu.IsActive && !_planSelectActive && !_showWizardInput && !_showWizardSelect)
{
    @if (Config.EnableTokenTracking && TokenTracker.TotalSessionTokens > 0)
    {
        <Box FillWidth="true" Height="1"><Markup Content=" " /></Box>
        <Box FillWidth="true" Height="1">
            <RazorConsole.Components.Align Horizontal="HorizontalAlignment.Right">
                <ContextMeterLine TotalSessionTokens="@TokenTracker.TotalSessionTokens"
                                  ShowContext="@(!MandoCodeConfig.IsCloudModel(Config.GetEffectiveModelName()) && TokenTracker.LastOperation is not null)"
                                  UsedTokens="@(TokenTracker.LastOperation?.PromptTokens ?? 0)"
                                  WindowTokens="@ContextMeter.KnownWindow(Config.GetEffectiveModelName(), Config.ContextLength)" />
            </RazorConsole.Components.Align>
        </Box>
    }
    <PromptInput @ref="_promptInput" @key="@ChatComposerKey" OnSubmit="HandleVdomSubmit"
                 ModelPicker="@_modelPicker"
                 OnModelSelected="HandleModelSelected"
                 OnModelPickerCancel="CancelModelPicker"
                 OnCancel="CancelCurrentRequest"
                 OnScroll="ScrollConversation"
                 InitialValue="@_promptInitialValue"
                 Disabled="@(_isProcessing || _historyActive)" />
}

@* Instruction input — surfaced by DiffApprovalHandler's "Provide new instructions" branch.
   Bridged via InstructionPromptCoordinator (TCS) so the imperative handler can await VDOM input. *@
@if (InstructionCoordinator.IsActive)
{
    @if (InstructionCoordinator.Multiline)
    {
        <PlanStepEditor @key="@InstructionCoordinator.RequestId" PersistenceKey="@InstructionCoordinator.RequestId.ToString()" Title="@InstructionCoordinator.Prompt" InitialValue="@InstructionCoordinator.InitialValue"
                        OnSubmit="HandleInstructionSubmit" OnCancel="InstructionCoordinator.Cancel" />
    }
    else
    {
    <PromptInput OnSubmit="HandleInstructionSubmit" PersistenceKey="@($"instruction-{InstructionCoordinator.RequestId}")"
                 InitialValue="@InstructionCoordinator.InitialValue"
                 Label="@InstructionCoordinator.Prompt"
                 Placeholder=""
                 ChatFeaturesEnabled="false"
                 AllowEmpty="true" />
    }
}

@* Approval menu — surfaced by DiffApprovalHandler for write / command / delete / MCP
   approvals. VDOM ApprovalSelect (same component as plan approval) instead of Spectre's
   SelectionPrompt so the keyboard pump is the only console reader and arrow keys can't be
   stolen mid-prompt, which previously hung a plan step. Bridged via
   ApprovalSelectCoordinator (TCS). *@
@if (ApprovalMenu.IsActive)
{
    @* A decision on something too long to print (a long diff) shows it here, scrolled with
       PgUp/PgDn from the menu, which keeps focus. *@
    @if (ApprovalMenu.Preview.Count > 0)
    {
        <ScrollPreview Title="@ApprovalMenu.PreviewTitle"
                       Lines="@ApprovalMenu.Preview"
                       Offset="@_approvalPreviewOffset"
                       PageSize="@ApprovalPreviewPageSize" />
    }
    <ApprovalSelect Options="@_approvalMenuOptions"
                    OnSubmit="HandleApprovalMenuSubmit"
                    OnScroll="HandleApprovalPreviewScroll" />
}


@* Wizard primitives — RazorConsole TextInput / ApprovalSelect that bypass PromptInput's slash/at
   autocomplete machinery. Used by interactive wizards that need free-form input. *@
@if (_showWizardInput)
{
    <TextInput @bind-Value="_wizardInputValue"
               OnSubmit="HandleWizardInputSubmit"
               Placeholder="@_wizardInputPlaceholder"
               MaskInput="@_wizardInputSecret"
               ValueColor="@(new Color(255, 200, 80))"
               PlaceholderColor="Color.Grey"
               BorderColor="Color.Purple"
               FocusedBorderColor="Color.Purple"
               BorderStyle="BoxBorder.Rounded"
               Expand="true"
               FocusOrder="0" />
}
@if (_showWizardSelect)
{
    @if (_wizardSelectTitle is not null)
    {
        <Markup Content="@Spectre.Console.Markup.Escape(_wizardSelectTitle)" Foreground="Color.DeepSkyBlue1" />
    }
    <ApprovalSelect Options="@_wizardSelectChoices" OnSubmit="HandleWizardSelectSubmit" />
}

@* Plan-approval select — VDOM replacement for the Spectre SelectionPrompt so arrow keys
   aren't stolen by the framework's keyboard pump (see ApprovalSelect.razor). Bridged to
   the awaiting handler with a TCS, same pattern as the wizard primitives above. *@
@if (_planSelectActive)
{
    <ApprovalSelect Options="@_planSelectOptions"
                    OnSubmit="HandlePlanSelectSubmit" />
}

}
</Footer>
</ChatShell>
}

