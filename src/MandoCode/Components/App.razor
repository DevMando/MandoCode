    private async Task<CliPeerAnswer> AskPeerAsync(CliPeerRequest request)
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (_paneStopped || Pane?.IsBusy?.Invoke() != false || Pane.IsAwaitingInput?.Invoke() == true ||
                    _inputTcs is null || _inputTcs.Task.IsCompleted || request.Cancellation.IsCancellationRequested)
                {
                    request.Accepted.TrySetResult(false);
                    request.Completion.TrySetResult(new(false, "Agent is busy, starting, awaiting input, or closed."));
                    return;
                }
                _peerRequest = request;
                _isProcessing = true;
                Pane.Session.AppendAgentExchange($"{CliAgentPresentation.PlainName(request.From)} · Request from{(request.IsDelegation ? " · " + request.InteractionId : "")}\n{CliAgentPresentation.PlainName(request.From)} → {CliAgentPresentation.PlainName(Pane.Name)}\n\n{request.Question}", Spectre.Console.Color.Purple, request.InteractionId, "Working");
                _inputTcs.TrySetResult($"A request from agent {request.From}:\n{request.Question}\n\nReturn your answer normally: it is automatically delivered to the requesting agent. Do not also send the same answer with send_agent_message.");
                request.Accepted.TrySetResult(true);
                StateHasChanged();
            });
            return await request.Completion.Task;
        }
        catch (Exception ex)
        {
            request.Accepted.TrySetResult(false);
            return new(false, ex.Message);
        }
    }
