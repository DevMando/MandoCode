    private Task SettingsModel()
    {
        var gate = Pane?.ModelSelection ?? _modelSelection;
        if (_isProcessing || !gate.TryEnter()) return Task.CompletedTask;
        _isProcessing = true;
        _ = RunSettingsModelAsync(gate);
        return Task.CompletedTask;
    }
    private async Task RunSettingsModelAsync(AgentModelSelectionGate gate)
    {
        using var output = Pane is null ? null : TuiConsole.Enter(Pane.Session);
        try { await SelectModelAsync(fromSettings: true); }
        catch (Exception ex) { _modelWarning = $"Couldn't change the model: {ex.Message}"; }
        finally { _isProcessing = false; gate.Exit(); await InvokeAsync(StateHasChanged); }
    }
    private async Task SaveAgentSettings(AgentSettingsDraft draft)
    {
        using var output = Pane is null ? null : TuiConsole.Enter(Pane.Session);
        if (_isProcessing) throw new InvalidOperationException("Wait for the current request to finish.");
        _isProcessing = true;
        Spinner.Start("Applying settings");
        try
        {
            var mcpChanged = Config.EnableMcp != draft.Config.EnableMcp;
            draft.ApplyTo(Config);
            AI.OnWriteApprovalRequested = Config.EnableDiffApprovals ? DiffApproval.HandleDiffApproval : null;
            AI.OnDeleteApprovalRequested = Config.EnableDiffApprovals ? DiffApproval.HandleDeleteApproval : null;
            AI.OnCommandApprovalRequested = Config.EnableDiffApprovals ? DiffApproval.HandleCommandApproval : null;
            McpGate.OnApprovalRequested = Config.EnableDiffApprovals ? DiffApproval.HandleMcpApproval : null;
            if (mcpChanged)
            {
                await McpManager.StopAllAsync();
                await InitializeMcpAsync();
            }
            await AI.RefreshSettingsAsync(Config);
            SaveAgentHistory(false);
        }
        finally { Spinner.Stop(); _isProcessing = false; }
    }
    private async Task ApplyAgentDefaults()
    {
        var defaults = ModelDefaults.Snapshot();
        Config.ModelName = defaults.GetEffectiveModelName();
        Config.ModelPath = null;
        await SaveAgentSettings(new AgentSettingsDraft(defaults));
    }
    private async Task SaveAgentDefaults(AgentSettingsDraft draft)
    {
        await SaveAgentSettings(draft);
        var agents = Pane is null ? new[] { Config } :
            (Pane.Workspace.Registry?.Workspaces.SelectMany(w => w.Panes) ?? Pane.Workspace.Panes)
                .Select(p => p.Services.GetRequiredService<MandoCodeConfig>());
        ModelDefaults.Promote(Config, agents);
    }
    private void GitDiscarded(string path)
    {
        AI.AppendUserNote($"The user DISCARDED uncommitted changes to {path}. Do not re-apply them unless asked.");
        using var output = Pane is null ? null : TuiConsole.Enter(Pane.Session);
        TuiConsole.MarkupLine($"[green]Discarded changes to {Spectre.Console.Markup.Escape(path)}[/]");
    }
    private async Task<string?> PickProjectDirectoryAsync()
    {
        _directorySelection = new(TaskCreationOptions.RunContinuationsAsynchronously);
        _fileExplorerOpen = false;
        _gitChangesOpen = false;
        _directoryBrowserOpen = true;
        await InvokeAsync(StateHasChanged);
        try { return await _directorySelection.Task; }
        finally
        {
            _directoryBrowserOpen = false;
            _directorySelection = null;
            await InvokeAsync(StateHasChanged);
