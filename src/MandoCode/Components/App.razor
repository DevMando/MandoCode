    // Music visualizer — animated equalizer while music plays
    private CancellationTokenSource? _musicVisCts;
    private Task? _musicVisTask;
    private readonly object _musicVisLock = new();

    private void StartMusicVisualizer()
    {
        if (TuiConsole.Current is not null) return;
        // Early-exit if a visualizer CTS is already active
        lock (_musicVisLock)
        {
            if (_musicVisCts != null)
                return;
        }

        StopMusicVisualizer();

        if (!MusicPlayer.IsPlaying && !MusicPlayer.IsPaused)
            return;

        ThemeService.IsMusicTitleActive = true;

        var cts = new CancellationTokenSource();
        var token = cts.Token;

        var task = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    var isPlaying = MusicPlayer.IsPlaying;
                    var trackName = MusicPlayer.CurrentTrack?.Name ?? "Unknown";

                    if (!MusicPlayer.IsPlaying && !MusicPlayer.IsPaused)
                        break;

                    // Animated equalizer in the terminal title bar — always visible,
                    // never overlaps scrollback content
                    var eq = isPlaying ? MusicAsciiArt.GetEqualizerFrame() : MusicAsciiArt.GetPausedEqualizerFrame();
                    var note = MusicAsciiArt.GetRandomNote();
                    var stateIcon = isPlaying ? "\u25b6" : "\u23f8";
                    var title = $"{note} {trackName}  {eq}  {stateIcon} MandoCode";
                    Console.Write($"\u001b]0;{title}\u0007");

                    await Task.Delay(isPlaying ? 150 : 500, token);
                }
            }
            catch (OperationCanceledException) { }
            finally
            {
                // Hand title bar back to status display
                try
                {
                    ThemeService.IsMusicTitleActive = false;
                    ThemeService.UpdateStatusTitle();
                }
                catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Failed to reset music title: {ex.Message}"); }
            }
        });

        lock (_musicVisLock)
        {
            _musicVisCts = cts;
            _musicVisTask = task;
        }
    }

    private void StopMusicVisualizer()
    {
        CancellationTokenSource? cts;
        Task? task;

        lock (_musicVisLock)
        {
            cts = _musicVisCts;
            task = _musicVisTask;
            _musicVisCts = null;
            _musicVisTask = null;
        }

        if (cts != null)
        {
            cts.Cancel();
            if (task != null)
            {
                try { task.Wait(1000); } catch (AggregateException) { }
            }
            cts.Dispose();
        }
    }





    private async Task InitializeConnectionAsync()
    {
        // Probe with auto-heal — silently fixes a trailing slash on the configured URL
        // (the most common config-time foot-gun) before any wizard or warning fires.
        var probe = await OllamaSetupHelper.ProbeAsync(Config.OllamaEndpoint);
        if (probe.WasHealed)
        {
            Config.OllamaEndpoint = probe.NormalizedUrl;
            Config.Save();
            AnsiConsole.MarkupLine($"[deepskyblue1]Detected trailing slash on Ollama URL — using {Spectre.Console.Markup.Escape(probe.NormalizedUrl)}[/]");
        }

        // First-run or recovering-from-broken-state: launch the guided wizard. Once a
        // user has completed (or explicitly skipped) onboarding, an unreachable Ollama
        // falls through to the static panel + /retry / /setup loop instead.
        var shouldOnboard = MandoCodeConfig.IsFirstRun() || !Config.HasCompletedOnboarding;
        if (shouldOnboard)
        {
            // Suppress HomeView while the wizard runs — otherwise the VDOM render
            // loop repaints over imperative AnsiConsole output (most importantly
            // the `ollama signin` URL, which the user needs to be able to read
            // and copy as a fallback if the browser auto-launch fails).
            _setupActive = true;
            await InvokeAsync(StateHasChanged);
            try
            {
                await RunOnboardingFlowAsync();
                probe = await OllamaSetupHelper.ProbeAsync(Config.OllamaEndpoint);
            }
            finally
            {
                _setupActive = false;
                await InvokeAsync(StateHasChanged);
            }
        }

        if (!probe.Ok) probe = await RecoverOllamaConnectionAsync();
        _isConnected = probe.Ok;
        _connectionChecked = true;

        if (_isConnected)
        {
            await ValidateCurrentModelAsync();
            await InitializeMcpAsync();
        }

        // Re-render so the VDOM updates from /learn content to the ready state
        await InvokeAsync(StateHasChanged);

        // Fire-and-forget the update check — never block the ready state on the network.
        // It self-throttles to once/24h and fails silent; the notice appears on the next
        // render once it resolves.
        _ = CheckForUpdatesAsync();
    }

    /// <summary>
    /// Background NuGet "newer version available" check. Sets <see cref="_updateNotice"/>
    /// and re-renders if an update exists; otherwise leaves the UI untouched. Swallows
    /// everything — an update nag must never disrupt the session.
    /// </summary>
    private async Task CheckForUpdatesAsync()
    {
        try
        {
            var update = await UpdateCheck.CheckForUpdateAsync();
            if (update is null) return;

            // Split so the banner can render the message in gold and the command in green
            // (Markup escapes inline color tags, so two-color text = two Markup elements).
            _updateNotice = $"✨ MandoCode {update.LatestVersion} is available!";
            _updateCommand = $"Run /update to upgrade, or run manually: {update.UpdateCommand}";
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Ignore — see method summary.
        }
    }

    /// <summary>
    /// Runs onboarding with component-based URL entry and the same model picker as
    /// /model. Other installation and sign-in choices retain their existing prompts.
    /// </summary>
    private async Task RunOnboardingFlowAsync(bool forceInteractive = false)
    {
        if (forceInteractive) await CaptureSnapshot();
        var contextCleared = false;
        _setupCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        _setupOpen = true;
        _fileExplorerOpen = _gitChangesOpen = _historyActive = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await _setupCompletion.Task;
            if (result.Connected && !string.IsNullOrEmpty(result.FinalModel))
            {
                await AI.ReinitializeAsync(Config);
                contextCleared = true;
            }
        }
        finally
        {
            _setupOpen = false;
            _setupCompletion = null;
            SetOnboardingStatus("");
        }
        if (forceInteractive && contextCleared && Snapshots.Pending is not null) await ShowSnapshots(false, true);
        else Snapshots.ClearPending();
    }
    private bool _setupOpen { get => _presentation.IsOpen(AgentPanel.Setup); set => _presentation.SetOpen(AgentPanel.Setup, value); }
    private TaskCompletionSource<OnboardingFlow.FlowResult>? _setupCompletion;
    private void SetupComplete(OnboardingFlow.FlowResult result) => _setupCompletion?.TrySetResult(result);

    private void SetOnboardingStatus(string status)
    {
        _onboardingStatus = status ?? "";
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Quick string sniff for "this response is a 401 cloud-auth error." Matches the
    /// `<red>Error: Ollama returned 401 Unauthorized.</red>` header used by both 401
    /// branches of <see cref="AIService.FormatHttpFailure"/> / <see cref="AIService.FormatErrorMessage"/>.
    /// </summary>
    private static bool Looks401(string responseText)
        => !string.IsNullOrEmpty(responseText)
           && responseText.Contains("401 Unauthorized", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Quick model-switch flow. Lists pulled models, lets the user pick one with
    /// cloud/local badges, then pipes them straight into the same context-size picker
    /// /config uses. Skips the rest of /config (temperature, timeout, ignore dirs) —
    /// those are reachable via /config as the final tip mentions.
    /// </summary>
    private async Task HandleModelCommandAsync()
    {
        var gate = Pane?.ModelSelection ?? _modelSelection;
        if (!gate.TryEnter()) return;
        try { await SelectModelAsync(); }
        finally { gate.Exit(); }
    }

    private readonly AgentModelSelectionGate _modelSelection = new();

    private async Task SelectModelAsync(bool fromSettings = false)
    {
        string[] labeled;
        Spinner.Start(message: "Loading models...");
        try
        {
            var probe = await OllamaSetupHelper.ProbeAsync(Config.OllamaEndpoint);
            if (!probe.Ok)
            {
                AnsiConsole.MarkupLine($"[yellow]Can't reach Ollama at {Spectre.Console.Markup.Escape(Config.OllamaEndpoint)}.[/]");
                AnsiConsole.MarkupLine("[dim]Run /retry to reconnect, or /setup to walk through setup again.[/]");
                return;
            }

            var fetched = await OllamaSetupHelper.ListModelsWithStatusAsync(probe.NormalizedUrl);
            if (!fetched.Ok)
            {
                AnsiConsole.MarkupLine("[yellow]Couldn't fetch your model list.[/]");
                AnsiConsole.MarkupLine($"[dim]Details: {Spectre.Console.Markup.Escape(fetched.Error ?? "unknown error")}[/]");
                AnsiConsole.MarkupLine("[dim]Run /retry to reconnect, or /setup to walk through setup again.[/]");
                return;
            }
            if (fetched.Models.Count == 0)
            {
                AnsiConsole.MarkupLine("[yellow]No models pulled yet.[/]");
                AnsiConsole.MarkupLine("[dim]Run /setup to install a starter model.[/]");
                return;
            }

            // Same picker layout as /setup's PickModelAsync — cloud bubbles to top,
            // alphabetical otherwise, badge after each tag, single-space split for
            // the tag.
            labeled = fetched.Models
                .OrderBy(m => MandoCodeConfig.IsCloudModel(m) ? 0 : 1)
                .ThenBy(m => m, StringComparer.OrdinalIgnoreCase)
                .Select(m => MandoCodeConfig.IsCloudModel(m)
                    ? $"{m}   (cloud)"
                    : $"{m}   (local)")
                .ToArray();

        }
        finally { Spinner.Stop(); }

        string modelTag;
        while (true)
        {
            var picked = await PickModelFromPromptAsync(labeled);
            if (picked is null) return;
            modelTag = picked.Split(' ')[0];
            string? error;
            Spinner.Start($"Checking {modelTag}…");
            try
            {
                using var client = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
                error = await OllamaModelAvailability.CheckCandidateAsync(client, Config.OllamaEndpoint, modelTag);
            }
            catch (Exception ex)
            {
                _modelWarning = $"Could not check {modelTag}: {ex.Message}. Try /model again.";
                await InvokeAsync(StateHasChanged);
                return;
            }
            finally { Spinner.Stop(); }
            if (error is null) break;
            System.Diagnostics.Debug.WriteLine($"[Model selection] {error}");
            if (!OllamaModelAvailability.OfferStartupPicker(modelTag, error))
            {
                _modelWarning = error;
                await InvokeAsync(StateHasChanged);
                return;
            }
            _modelWarning = $"{modelTag} is no longer available. Choose another model below.";
            labeled = labeled.Where(option => option != picked).ToArray();
            if (labeled.Length == 0)
            {
                _modelWarning = "None of the listed cloud models are available. Use /setup to configure another model.";
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        var previousModel = Config.GetEffectiveModelName();
        if (!fromSettings && !string.Equals(previousModel, modelTag, StringComparison.Ordinal)) await CaptureSnapshot();
        Config.ModelName = modelTag;
        Config.ModelPath = null;

        // /model is the QUICK switch — no settings quiz. Response length lives in /config.
        // Local picks get a context window sized to the hardware tier the tag implies, unless
        // the user chose one; cloud models manage context server-side.
        switch (Config.ApplyRecommendedContextLength(previousModel, modelTag))
        {
            case MandoCodeConfig.ContextWindowChange.Resized:
                AnsiConsole.MarkupLine($"[dim]Context window sized to {Config.ContextLength / 1024}k tokens for this model tier.[/]");
                break;
            case MandoCodeConfig.ContextWindowChange.Kept:
                AnsiConsole.MarkupLine($"[dim]Kept your {MandoCodeConfig.ContextLengthLabel(Config.ContextLength)} context window (/config set contextLength auto to size it for each model).[/]");
                break;
        }

        Spinner.Start($"Loading {modelTag}…");
        try
        {
            if (fromSettings || string.Equals(previousModel, modelTag, StringComparison.Ordinal)) await AI.RefreshSettingsAsync(Config);
            else await AI.ReinitializeAsync(Config);
        }
        finally { Spinner.Stop(); }

        await ValidateCurrentModelAsync();
        if (!fromSettings && Snapshots.Pending is not null) await ShowSnapshots(false, true);
        if (_modelError || fromSettings) return;
        var defaultChoice = await WizardPromptSelectCoreAsync(
            $"Make {modelTag} the default model for new agents?",
            new[] { "No — only this agent", "Yes — new agents use this model" },
            liveTitle: true);
        AnsiConsole.MarkupLine($"[green]✓ Now using {Spectre.Console.Markup.Escape(modelTag)}.[/]");
        if (defaultChoice.StartsWith("Yes", StringComparison.Ordinal))
        {
            var agents = Pane is null ? new[] { Config } :
                (Pane.Workspace.Registry?.Workspaces.SelectMany(w => w.Panes) ?? Pane.Workspace.Panes)
                    .Select(p => p.Services.GetRequiredService<MandoCodeConfig>());
            ModelDefaults.Select(modelTag, agents);
            AnsiConsole.MarkupLine("[dim]Default model updated for new agents.[/]");
        }

        AnsiConsole.WriteLine();
    }

    /// <summary>
    /// Inline setting change without leaving the session: "/config set <key> <value>".
    /// Shares ConfigKeySetter with the CLI's --config set so key names and validation
    /// can never drift. ApplyScope decides what happens after a successful set: live
    /// keys just save; kernel-baked keys rebuild the kernel WITHOUT clearing history.
    /// </summary>
    private async Task HandleConfigSetCommandAsync(string args)
    {
        var parts = args.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2)
        {
            AnsiConsole.MarkupLine("[deepskyblue1]Usage:[/] /config set <key> <value>");
            AnsiConsole.WriteLine();
            AnsiConsole.MarkupLine("[dim]Available keys (current values):[/]");
            WriteConfigKeyListing(ConfigKeySetter.DescribeKeys(Config));
            AnsiConsole.WriteLine();
            return;
        }

        var result = ConfigKeySetter.TrySet(Config, parts[0], parts[1]);
        AnsiConsole.WriteLine(result.Message);

        if (!result.Ok)
        {
            AnsiConsole.MarkupLine("[dim]Run [deepskyblue1]/config set[/] with no arguments to list keys and current values.[/]");
            AnsiConsole.WriteLine();
            return;
        }

        var agentsForDefaults = Pane is null ? new[] { Config } :
            (Pane.Workspace.Registry?.Workspaces.SelectMany(w => w.Panes) ?? Pane.Workspace.Panes)
                .Select(p => p.Services.GetRequiredService<MandoCodeConfig>());
        ModelDefaults.UpdateSetting(parts[0], parts[1], agentsForDefaults);
        Config.Save();

        if (parts[0].Equals("showTips", StringComparison.OrdinalIgnoreCase) && Pane?.Workspace.Registry is { } tipsRegistry)
        {
            foreach (var agent in tipsRegistry.Workspaces.SelectMany(w => w.Panes))
                agent.Services.GetRequiredService<MandoCodeConfig>().ShowTips = Config.ShowTips;
            foreach (var workspace in tipsRegistry.Workspaces) workspace.Refresh();
        }
        if (parts[0].Equals("dimUnfocusedAgents", StringComparison.OrdinalIgnoreCase) && Pane?.Workspace.Registry is { } dimRegistry)
        {
            foreach (var agent in dimRegistry.Workspaces.SelectMany(w => w.Panes))
            {
                agent.Services.GetRequiredService<MandoCodeConfig>().DimUnfocusedAgents = Config.DimUnfocusedAgents;
            }
            foreach (var workspace in dimRegistry.Workspaces) workspace.Refresh();
        }
        if (parts[0].Equals("agentNaming", StringComparison.OrdinalIgnoreCase) && Pane?.Workspace.Registry is { } registry)
            foreach (var agent in registry.Workspaces.SelectMany(w => w.Panes))
                agent.Services.GetRequiredService<MandoCodeConfig>().UseAgentNames = Config.UseAgentNames;
        // Some keys (tavilyKey) carry a live verification probe — instant "your key
        // works" feedback at set time instead of a silent failure on first real use.
        if (result.PostSetValidation != null)
        {
            AnsiConsole.WriteLine(await result.PostSetValidation());
        }

        switch (result.Scope)
        {
            case ConfigKeySetter.ApplyScope.KernelRebuild:
                await AI.RefreshSettingsAsync(Config);
                AnsiConsole.MarkupLine("[dim]Applied — conversation history kept.[/]");
                break;
            case ConfigKeySetter.ApplyScope.Immediate:
                AnsiConsole.MarkupLine("[dim]Takes effect on your next message.[/]");
                break;
            case ConfigKeySetter.ApplyScope.AppRestart:
                AnsiConsole.MarkupLine("[dim]Saved — takes effect the next time MandoCode starts.[/]");
                break;
            case ConfigKeySetter.ApplyScope.DaemonRestart:
                // The setter's own message already explains the daemon/slider situation.
                break;
        }
        AnsiConsole.WriteLine();
    }

    /// <summary>
    /// Renders the plain-text key listing from ConfigKeySetter.DescribeKeys with the
    /// app palette: key deepskyblue, current value gold, range hint green. The string
    /// itself stays uncolored because the CLI prints it raw and the anti-drift test
    /// parses it.
    /// </summary>
    private static void WriteConfigKeyListing(string listing)
    {
        foreach (var line in listing.Split('\n'))
        {
            var match = System.Text.RegularExpressions.Regex.Match(
                line, @"^(\S+)(\s+)(.*?)(\s*\(.*)?$");
            if (!match.Success)
            {
                AnsiConsole.WriteLine(line);
                continue;
            }

            var key = Spectre.Console.Markup.Escape(match.Groups[1].Value);
            var gap = match.Groups[2].Value;
            var value = Spectre.Console.Markup.Escape(match.Groups[3].Value);
            var hint = Spectre.Console.Markup.Escape(match.Groups[4].Value);
            AnsiConsole.MarkupLine(
                $"[deepskyblue1]{key}[/]{gap}[rgb(255,200,80)]{value}[/][green]{hint}[/]");
        }
    }

    /// <summary>
    /// Auto-launch the cloud sign-in walkthrough after a chat response surfaced a 401.
    /// Same flow as the menu inside /setup, but invoked inline so the user doesn't have
    /// to type /setup → re-pick the model → wait for the auth check just to reach the
    /// "Sign me in now" prompt they obviously need. Hides HomeView via _setupActive so
    /// the walkthrough's imperative output isn't overlapped by VDOM redraws.
    /// </summary>
    private async Task TryAutoSigninAfter401Async()
    {
        AnsiConsole.WriteLine();
        AnsiConsole.MarkupLine("[deepskyblue1]Launching sign-in walkthrough so you can fix this now...[/]");
        AnsiConsole.WriteLine();

        _setupActive = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var flow = new OnboardingFlow(
                setStatus: SetOnboardingStatus,
                promptTextVdom: (title, placeholder, validate, initialValue) => WizardPromptTextAsync(title, placeholder, validate, initialValue));

            var signedIn = await flow.WalkThroughCloudSigninAsync(Config.OllamaEndpoint);
            if (signedIn)
            {
                // Reinitialize the kernel against the (now-authenticated) daemon so
                // the next chat doesn't re-hit a stale connection.
                await AI.ReinitializeAsync(Config);
                AnsiConsole.WriteLine();
                AnsiConsole.MarkupLine("[green]✓ Signed in. Re-send your message to try again.[/]");
                AnsiConsole.WriteLine();
            }
        }
        finally
        {
            SetOnboardingStatus("");
            _setupActive = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Start MCP clients and attach their tools to the kernel. Failures per-server are
    /// surfaced via `/mcp` — a broken server never blocks the app from starting.
    /// </summary>
    private async Task InitializeMcpAsync()
    {
        if (!Config.EnableMcp || Config.McpServers.Count == 0) return;

        try
        {
            await McpManager.StartAllAsync();
            await AI.AttachMcpPluginsAsync();

            var active = McpManager.ActiveClients.Count;
            var failed = McpManager.StartupErrors.Count;
            if (active > 0 || failed > 0)
            {
                var summary = failed == 0
                    ? $"[dim]MCP: {active} server(s) connected.[/]"
                    : $"[dim]MCP: {active} connected, {failed} failed (type /mcp for details).[/]";
                AnsiConsole.MarkupLine(summary);
            }
        }
        catch (Exception ex)
        {
            AnsiConsole.MarkupLine($"[yellow]MCP startup error: {Spectre.Console.Markup.Escape(ex.Message)}[/]");
        }
    }

    private async Task ValidateCurrentModelAsync()
    {
        // Validate that model supports function calling
        var (isValid, errorMessage) = await AI.ValidateModelAsync();
        if (!isValid && errorMessage != null)
        {
            System.Diagnostics.Debug.WriteLine($"[Model validation] {errorMessage}");
            if (errorMessage.Contains("Continue anyway?"))
            {
                AnsiConsole.MarkupLine("[yellow]Warning:[/]");
                AnsiConsole.WriteLine(errorMessage);
                var continueAnyway = AnsiConsole.Confirm("Continue with this model?", false);
                if (!continueAnyway)
                {
                    AnsiConsole.WriteLine("Please configure a supported model:");
                    AnsiConsole.WriteLine("  mandocode --config set model qwen2.5-coder:14b");
                    AnsiConsole.WriteLine("  ollama pull qwen2.5-coder:14b");
                    ThemeService.ResetPalette();
                    ThemeService.Dispose();
                    Environment.ExitCode = 1;
                    Lifetime.StopApplication();
                    return;
                }
            }
            else
            {
                // Hard error (model not found) — enter limited mode
                _modelError = true;
                if (OllamaModelAvailability.OfferStartupPicker(Config.GetEffectiveModelName(), errorMessage))
                {
                    _modelWarning = $"{Config.GetEffectiveModelName()} is no longer available. Choose another model below.";
                    _offerStartupModelPicker = !_hasRendered;
                }
                else
                {
                    _modelWarning = errorMessage;
                }
            }
        }
        else
        {
            _modelError = false;
            _modelWarning = null;
        }
    }

    private void OnFunctionInvoked(FunctionCall call)
    {
        // Pause the spinner so the message renders on a clean line
        Spinner.Stop();

        // What the model wrote before this call prints now, above the call's line.
        PrintReplySoFar();

        using var toolOutput = (Pane?.Session ?? TuiConsole.Current)?.CaptureToolOutput(invoked: true);

        // Track operation type for contextual spinner messages
        _lastOperationType = call.FunctionName.Replace("FileSystem_", "").ToLowerInvariant();

        var activityLabel = call.McpServerName is null ? ToolActivityIcons.Label(call.FunctionName, call.Description) : call.Description;
        AnsiConsole.MarkupLine($"[#56b6c2]{ToolActivityIcons.For(call.FunctionName, call.McpServerName is not null)} {Spectre.Console.Markup.Escape(activityLabel)}[/]");

        // Show what the model is doing above the spinner in grey
        Spinner.Start(activityLabel);
    }

    private void OpenReply()
    {
        lock (_replyLock)
        {
            _replyOpen = true;
            _replyBlockPrinted = false;
            _replyUnprinted.Clear();
            _replyPrinted.Clear();
        }
    }

    private void CloseReply()
    {
        lock (_replyLock) _replyOpen = false;
        Spinner.UpdatePreview(null);
    }

    // The spinner's live preview only needs the tail of the reply, and copying the whole buffer on
    // every chunk would make a long reply quadratic.
    private const int PreviewTailChars = 4000;

    private void OnResponseTextDelta(string text)
    {
        string preview;
        lock (_replyLock)
        {
            if (!_replyOpen) return;
            _replyUnprinted.Append(text);
            var start = Math.Max(0, _replyUnprinted.Length - PreviewTailChars);
            preview = _replyUnprinted.ToString(start, _replyUnprinted.Length - start);
        }
        Spinner.UpdatePreview(preview);
    }

    // A retried model call streams its reply again from the start.
    private void OnResponseStreamStarted()
    {
        lock (_replyLock) _replyUnprinted.Clear();
        Spinner.UpdatePreview(null);
    }

    /// <summary>
    /// Prints the reply streamed so far as its own block, ahead of the tool call about to run.
    /// Only for a call the model made mid-stream (<see cref="AIService.IsStreamingModelCall"/>): a
    /// tool call written as text runs after the stream, and its raw text is about to be stripped
    /// from the reply, so it's left for the final text. Scrollback can't take a print back.
    /// </summary>
    private void PrintReplySoFar()
    {
        string text;
        lock (_replyLock)
        {
            if (!_replyOpen || !AI.IsStreamingModelCall) return;
            text = _replyUnprinted.ToString().Trim();
            _replyUnprinted.Clear();
            if (text.Length == 0) return;
            _replyPrinted.Add(text);
        }
        Spinner.UpdatePreview(null);
        PrintReplyHeading();
        RenderMarkdownGuarded(text);
    }

    private void PrintReplyHeading()
    {
        if (_replyBlockPrinted) AnsiConsole.WriteLine(" ");
        _replyBlockPrinted = true;
        AnsiConsole.MarkupLine($"[green]{Spectre.Console.Markup.Escape(Config.AgentName ?? "MandoCode")}:[/]");
    }

    /// <summary>A turn finished with <paramref name="turnText"/>: returns what of it still needs
    /// printing, and resets for the next turn.</summary>
    private string SettleReply(string turnText)
    {
        List<string> printed;
        lock (_replyLock)
        {
            printed = _replyPrinted.ToList();
            _replyPrinted.Clear();
            _replyUnprinted.Clear();
        }
        Spinner.UpdatePreview(null);
        return ReplyText.Unshown(turnText, printed);
    }

    private void OnFunctionCompleted(MandoCode.Models.FunctionExecutionResult result)
    {
        using var toolOutput = (Pane?.Session ?? TuiConsole.Current)?.CaptureToolOutput(invoked: false, success: result.Success);
        // Pause the spinner so the message renders on a clean line
        Spinner.Stop();

        if (result.OperationDisplay != null)
        {
            // Render directly to stdout (capture deferred to Phase 2)
            OperationRenderer.Render(result.OperationDisplay);

            // Track consecutive reads for contextual spinner messages
            if (result.OperationDisplay.OperationType == "Read")
            {
                _recentReadCount++;
                var fileName = Path.GetFileName(result.OperationDisplay.FilePath);
                if (!string.IsNullOrEmpty(fileName))
                    _recentReadFiles.Add(fileName);
            }
            else
            {
                // Non-read operation resets the read tracker
                _recentReadCount = 0;
                _recentReadFiles.Clear();
            }
        }
        if (result.Success)
        {
            AnsiConsole.MarkupLine("[green]✅ Completed[/]");
        }
        else
        {
            AnsiConsole.MarkupLine($"[red]✗ Failed · {Spectre.Console.Markup.Escape(result.Result)}[/]");
        }

        // Refresh file cache after any operation that modifies the file system
        var fnLower = result.FunctionName.ToLowerInvariant();
        if (result.Success && !fnLower.StartsWith("list") && (fnLower.Contains("write") || fnLower.Contains("delete") || fnLower.Contains("create") || fnLower.Contains("rename") || fnLower.Contains("move")))
        {
            FileProvider.RefreshCache();
        }

        // Show contextual spinner message based on what just happened
        var activity = GetContextualActivity(result);
        Spinner.Start(activity);
    }

    /// <summary>
    /// Generates a contextual activity message for the spinner based on recent operations.
    /// </summary>
    private string? GetContextualActivity(FunctionExecutionResult result)
    {
        var opType = result.OperationDisplay?.OperationType ?? _lastOperationType ?? "";

        return opType switch
        {
            "Read" when _recentReadCount >= 2 => $"Analyzing {_recentReadCount} files...",
            "Read" => "Analyzing file...",
            "Write" or "Update" => "Applying changes...",
            "Search" => "Reviewing search results...",
            "Glob" => "Scanning project structure...",
            "WebSearch" => "Processing search results...",
            "WebFetch" => "Reading web content...",
            "Delete" => "Continuing...",
            "Command" => "Processing command output...",
            _ => null
        };
    }

    /// <summary>
    /// Checks if a function name belongs to the FileSystem plugin.
    /// </summary>
    private bool IsFileSystemOperation(string functionName)
    {
        return functionName.StartsWith("FileSystem_", StringComparison.Ordinal);
    }

    private async Task<bool> CheckOllamaConnectionAsync()
    {
        var probe = await OllamaSetupHelper.ProbeAsync(Config.OllamaEndpoint);
        if (probe.WasHealed)
        {
            // /retry hit the slash bug — heal silently here too so the user doesn't have
            // to restart to clear the typo.
            Config.OllamaEndpoint = probe.NormalizedUrl;
            Config.Save();
        }
        return probe.Ok;
    }

