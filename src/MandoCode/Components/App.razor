    private async Task HandleVdomSubmit(string input)
    {
        if (IntegrationCoordinator.IsUpdating) return;
        var rename = input.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        if (rename.Length > 0 && (rename[0].Equals("/tips-on", StringComparison.OrdinalIgnoreCase)
            || rename[0].Equals("/tips-off", StringComparison.OrdinalIgnoreCase)))
        {
            await HandleConfigSetCommandAsync("showTips " + (rename[0].Equals("/tips-on", StringComparison.OrdinalIgnoreCase) ? "on" : "off"));
            return;
        }
        if (rename.Length > 0 && (rename[0].Equals("/agent-dim", StringComparison.OrdinalIgnoreCase)
            || rename[0].Equals("/agent-dim-on", StringComparison.OrdinalIgnoreCase)
            || rename[0].Equals("/agent-dim-off", StringComparison.OrdinalIgnoreCase)))
        {
            var value = rename[0].Equals("/agent-dim-on", StringComparison.OrdinalIgnoreCase) ? "on"
                : rename[0].Equals("/agent-dim-off", StringComparison.OrdinalIgnoreCase) ? "off"
                : rename.Length > 1 ? rename[1] : Config.DimUnfocusedAgents ? "off" : "on";
            await HandleConfigSetCommandAsync("dimUnfocusedAgents " + value);
            return;
        }
        if (Pane is not null && rename.Length > 0 && rename[0].Equals("/agent-rename", StringComparison.OrdinalIgnoreCase))
        {
            if (_isProcessing || Pane.IsBusy?.Invoke() == true)
            {
                Pane.Session.Append(new Spectre.Console.Text("Finish or cancel the current request before renaming this agent."));
                return;
            }
            if (Pane.Workspace.Rename(Pane, rename.Length > 1 ? rename[1] : ""))
            {
                _isProcessing = true;
                try
                {
                    await AI.RefreshSettingsAsync(Config);
                    Pane.Session.Append(new Spectre.Console.Text($"Agent renamed to {Pane.Name}."));
                }
                finally { _isProcessing = false; }
            }
            return;
        }
        if (Pane is not null && Pane.Workspace.Command(Pane, input)) return;
        if (_isProcessing || _inputTcs is null || _inputTcs.Task.IsCompleted) return;
        if (!string.IsNullOrWhiteSpace(input)) (Pane?.Session ?? TuiConsole.Current)?.AppendUserPrompt(input, Pane is null ? null : new CliAgentDirectory(Pane).All.Select(p => p.Name));
        _isProcessing = true;
        _inputTcs.TrySetResult(input);
    }

