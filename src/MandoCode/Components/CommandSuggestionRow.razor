@using Spectre.Console
@using RazorConsole.Core.Renderables
@inject RazorConsole.Core.Rendering.ITerminalViewport Viewport

<Box FillWidth="true" Height="1">
    @if (Selected)
    {
        <Markup Content="@(CommandField + (DescriptionWidth > 0 ? " " + DescriptionField : ""))"
                Foreground="@PaneColors.For(Pane, Color.Black)" Background="@(PaneColors.Muted(Pane) ? Color.Grey19 : new Color(86, 182, 194))" />
    }
    else
    {
        <Flex Direction="FlexDirection.Row" Gap="1" Height="1" FillWidth="true">
            <Markup Content="@CommandField" Foreground="@PaneColors.For(Pane, new Color(86, 182, 194))" />
            @if (DescriptionWidth > 0)
            {
                <Markup Content="@DescriptionField" Foreground="@PaneColors.For(Pane, Color.Green)" />
            }
        </Flex>
    }
</Box>

@code {
    [CascadingParameter] public AgentPane? Pane { get; set; }
    [Parameter] public string Command { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public int CommandColumn { get; set; } = 14;
    [Parameter] public bool Selected { get; set; }
    private int Width => Math.Max(1, (Pane?.Width ?? Viewport.Width) - 4);
    private int CommandWidth => Math.Min(Width, CommandColumn);
    private int DescriptionWidth => Math.Max(0, Width - CommandWidth - 1);
    private string CommandField => Fit(Command, CommandWidth);
    private string DescriptionField
    {
        get
        {
            var separator = Description.LastIndexOf(" (Alt+", StringComparison.Ordinal);
            if (separator < 0) return Fit(Description, DescriptionWidth);
            var shortcut = Description[(separator + 1)..];
            if (DescriptionWidth < shortcut.Length + 1) return Fit(shortcut, DescriptionWidth);
            return Fit(Description[..separator], DescriptionWidth - shortcut.Length - 1) + " " + shortcut;
        }
    }
    private static string Fit(string text, int width)
    {
        var result = new System.Text.StringBuilder();
        var cells = 0;
        foreach (var rune in text.EnumerateRunes())
        {
            if (System.Text.Rune.IsControl(rune)) continue;
            var size = RazorConsole.Core.Input.TextSelectionState.CellWidth(rune.ToString());
            if (cells + size > width) break;
            cells += size;
            result.Append(rune.ToString());
        }
        result.Append(' ', Math.Max(0, width - cells));
        return result.ToString();
    }
}
