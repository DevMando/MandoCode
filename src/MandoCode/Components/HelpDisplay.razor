@using Spectre.Console

@*
    RazorConsole's Markup component escapes Content (no inline [color] tags) —
    styling must come through the Foreground parameter. The two-column Grid keeps
    command/description colors separate and auto-aligns the columns.
*@

<Panel Title="Commands" Border="@BoxBorder.Rounded" BorderColor="@PaneColors.For(Pane, Color.DeepSkyBlue1)">
    <Rows>
        <Grid Columns="2">
            <Markup Content="/help" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- View all available commands" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/model" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Choose a different model" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/config" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Configure MandoCode" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/plan" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Create a plan before making changes" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/agent-new" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="@($"- Open another agent ({Keybindings.AgentNew})")" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/keybindings" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- View keyboard shortcuts" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/clear" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Start a fresh conversation" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/music" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Play coding music" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/exit" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Exit MandoCode" Foreground="@PaneColors.For(Pane, Color.Green)" />
        </Grid>
    </Rows>
</Panel>

@code {
    [CascadingParameter] public AgentPane? Pane { get; set; }
}
