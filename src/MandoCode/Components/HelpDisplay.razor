@using Spectre.Console

@*
    RazorConsole's Markup component escapes Content (no inline [color] tags) —
    styling must come through the Foreground parameter. The two-column Grid keeps
    command/description colors separate and auto-aligns the columns.
*@

<Panel Title="Commands" Border="@BoxBorder.Rounded" BorderColor="@PaneColors.For(Pane, Color.DeepSkyBlue1)">
    <Rows>
        <Grid Columns="2">
            <Markup Content="/help" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- View all commands" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/model" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Choose a model" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/ollama-pull" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Find and download models" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/mcp" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="@($"- Manage MCP servers ({MandoCode.Models.Keybindings.McpServers})")" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/skills" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="@($"- Manage skills ({MandoCode.Models.Keybindings.Skills})")" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/snapshot-context-import" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="@($"- Manage context snapshots ({MandoCode.Models.Keybindings.ContextSnapshots})")" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/clear" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Start a fresh conversation" Foreground="@PaneColors.For(Pane, Color.Green)" />
            <Markup Content="/exit" Foreground="@PaneColors.For(Pane, Color.DeepSkyBlue1)" />
            <Markup Content="- Exit MandoCode" Foreground="@PaneColors.For(Pane, Color.Green)" />
        </Grid>
    </Rows>
</Panel>

@code {
    [CascadingParameter] public AgentPane? Pane { get; set; }
}
