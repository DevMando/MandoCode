@using Spectre.Console;

<AsciiArt Lines="@Artwork" />

@code {
    [CascadingParameter] public AgentPane? Pane { get; set; }

    // Gate the easter-egg roll so it happens at most once per process launch.
    // Razor re-instantiates components on some re-renders, which otherwise fires
    // OnInitialized multiple times and rolls the dice again — when the glitch
    // does hit mid-session, Console.Clear() wipes the screen and the VDOM paints
    // the startup block fresh, looking exactly like a restart.
    private static bool _glitchRolled;

    protected override void OnInitialized()
    {
        // Easter egg: 1-in-50 chance of a brief "Neo's monitor" glitch — only on first init.
        if (!_glitchRolled)
        {
            _glitchRolled = true;
            if (Pane is null && TuiConsole.Current is null && !Console.IsOutputRedirected && Random.Shared.Next(50) == 0)
            {
                PlayMatrixGlitch();
            }
        }

    }

    private static string ResolveVersionLabel()
        => MandoCode.Services.VersionLabel.ForAssembly(typeof(Program).Assembly);

    // ════════════════════════════════════════════
    //  Gradient MANDOCODE figlet text
    // ════════════════════════════════════════════

    private static readonly string[] _figletLines =
    {
        @"",
       @" ███╗   ███╗ █████╗ ███╗   ██╗██████╗  ██████╗  ██████╗ ██████╗ ██████╗ ███████╗ ",
       @" ████╗ ████║██╔══██╗████╗  ██║██╔══██╗██╔═══██╗██╔════╝██╔═══██╗██╔══██╗██╔════╝ ",
       @" ██╔████╔██║███████║██╔██╗ ██║██║  ██║██║   ██║██║     ██║   ██║██║  ██║█████╗ ",
       @" ██║╚██╔╝██║██╔══██║██║╚██╗██║██║  ██║██║   ██║██║     ██║   ██║██║  ██║██╔══╝ ",
       @" ██║ ╚═╝ ██║██║  ██║██║ ╚████║██████╔╝╚██████╔╝╚██████╗╚██████╔╝██████╔╝███████╗ ",
       @" ╚═╝     ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝╚═════╝  ╚═════╝  ╚═════╝ ╚═════╝ ╚═════╝ ╚══════╝"
    };

    private IReadOnlyList<string> Artwork => _figletLines.Concat(new[]
    {
        @" ░▒▓░░▒▓▒░░▒▓░░▒▓▒░░▒▓░░▒▓▒░░▒▓░░▒▓▒░░▒▓░░▒▓▒░░▒▓░░▒▓▒░░▒▓░░▒▓▒░░▒▓░▒▓▒░░▒▓░░▒▓▒",
        @" ▓░▒▓░░░▒▓░▒░░▓▒░░░▒▓░░▒░▓░░▒▓░░▒░▓░░▒▓░░▒░▓░░▒▓░░▒░▓░░▒▓░░▒░▓░░▒▓░▒▓░░▒▓" + ResolveVersionLabel()
    }).ToArray();

    private static void PlayMatrixGlitch()
    {
        Console.Clear();
        Thread.Sleep(400);
        AnsiConsole.MarkupLine("[green]Wake up...[/]");
        Thread.Sleep(800);
        AnsiConsole.MarkupLine("[green]The Matrix has you...[/]");
        Thread.Sleep(800);
        AnsiConsole.MarkupLine("[green]Follow the white rabbit. 🐇[/]");
        Thread.Sleep(1200);
        Console.Clear();
    }
}
